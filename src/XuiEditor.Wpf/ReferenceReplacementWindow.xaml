<Window x:Class="XuiEditor.Wpf.ReferenceReplacementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inspect / Replace Workspace References"
        Width="820"
        Height="520"
        MinWidth="680"
        MinHeight="420"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="InstructionText"
                   Grid.Row="0"
                   Text="Workspace XUI files only. Preview is required; archives are excluded. Apply creates file backups and rolls back atomically on failure."
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="95" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Current value" VerticalAlignment="Center" />
            <TextBox x:Name="CurrentValueText"
                     Grid.Column="1"
                     IsReadOnly="True" />
            <TextBlock Grid.Column="2"
                       Text="Replacement"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center" />
            <TextBox x:Name="ReplacementValueText"
                     Grid.Column="3"
                     TextChanged="ReplacementValue_TextChanged" />
            <Button Grid.Column="4"
                    Content="Preview diff"
                    Margin="8,0,0,0"
                    Click="Preview_Click" />
        </Grid>
        <DataGrid x:Name="PreflightGrid"
                  Grid.Row="2"
                  Margin="0,10,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File"
                                    Binding="{Binding FilePath}"
                                    Width="*" />
                <DataGridTextColumn Header="Node"
                                    Binding="{Binding NodeDisplay}"
                                    Width="130" />
                <DataGridTextColumn Header="Property"
                                    Binding="{Binding PropertyName}"
                                    Width="135" />
                <DataGridTextColumn Header="Old"
                                    Binding="{Binding CurrentValue}"
                                    Width="140" />
                <DataGridTextColumn Header="New"
                                    Binding="{Binding ReplacementValue}"
                                    Width="140" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText"
                   Grid.Row="3"
                   Margin="0,8,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="85" />
            <Button x:Name="ApplyButton"
                    Content="Apply with backups"
                    IsEnabled="False"
                    MinWidth="130"
                    Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
