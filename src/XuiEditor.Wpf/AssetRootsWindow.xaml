<Window x:Class="XuiEditor.Wpf.AssetRootsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dying Light Resource Settings"
        Width="900"
        Height="700"
        MinWidth="720"
        MinHeight="560"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Dying Light installation"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InstallText"
                     Grid.Column="0"
                     TextChanged="InstallText_TextChanged"
                     ToolTip="Folder containing DyingLightGame.exe and DW\Data0.pak" />
            <Button Grid.Column="1"
                    Content="Browse…"
                    Margin="7,0,0,0"
                    Click="BrowseInstall_Click" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Language"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <ComboBox x:Name="LocaleCombo"
                      Grid.Column="1"
                      IsEditable="True"
                      ToolTip="Selected catalog with English fallback" />
            <TextBlock Grid.Column="3"
                       Text="Input prompts"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <ComboBox x:Name="InputGlyphCombo"
                      Grid.Column="4"
                      ToolTip="Keyboard/mouse, Xbox, or DualShock glyph catalog" />
            <TextBlock x:Name="InstallValidationText"
                       Grid.Column="5"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Foreground="{StaticResource MutedTextBrush}" />
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="Writable workspace"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WorkspaceText"
                     Grid.Column="0"
                     ToolTip="Stock XUIs must be saved here or another writable location" />
            <Button Grid.Column="1"
                    Content="Browse…"
                    Margin="7,0,0,0"
                    Click="BrowseWorkspace_Click" />
        </Grid>

        <TabControl Grid.Row="7">
            <TabItem Header="Resource folders">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Higher rows override lower rows and installed game data"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5" />
                        <DataGrid x:Name="RootsGrid"
                                  ItemsSource="{Binding Roots}"
                                  SelectedIndex="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  Background="{StaticResource PanelBrush}"
                                  Foreground="{StaticResource TextBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Path"
                                                    Binding="{Binding Path}"
                                                    Width="*" />
                                <DataGridComboBoxColumn Header="Kind"
                                                        SelectedItemBinding="{Binding Kind}"
                                                        Width="160" />
                                <DataGridCheckBoxColumn Header="Read only"
                                                        Binding="{Binding IsReadOnly}"
                                                        Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Margin="9,26,0,0">
                        <Button Content="Add DL project…"
                                ToolTip="Add a Workshop or Developer Tools project folder"
                                Click="AddProject_Click" />
                        <Button Content="Add loose resources…"
                                Click="AddLooseResources_Click" />
                        <Button Content="Add loose mod…"
                                Click="AddLoose_Click" />
                        <Button Content="Add extracted…"
                                Click="AddExtracted_Click" />
                        <Button Content="Remove" Click="Remove_Click" />
                        <Separator Margin="3,8" />
                        <Button Content="Move up" Click="MoveUp_Click" />
                        <Button Content="Move down" Click="MoveDown_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Definitions and RPACKs">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Additional files are indexed read-only before installed game assets"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5" />
                        <DataGrid x:Name="SourcesGrid"
                                  ItemsSource="{Binding AdditionalSources}"
                                  SelectedIndex="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  Background="{StaticResource PanelBrush}"
                                  Foreground="{StaticResource TextBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Path"
                                                    Binding="{Binding Path}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Kind"
                                                    Binding="{Binding DisplayKind}"
                                                    IsReadOnly="True"
                                                    Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Margin="9,26,0,0">
                        <Button Content="Add texture definitions…"
                                ToolTip="Add a .def or texture-definition .scr file"
                                Click="AddTextureDefinitions_Click" />
                        <Button Content="Add RPACK…"
                                ToolTip="Add a Dying Light RP6L .rpack resource container"
                                Click="AddRpack_Click" />
                        <Button Content="Remove"
                                Click="RemoveSource_Click" />
                        <Separator Margin="3,8" />
                        <Button Content="Move up"
                                Click="MoveSourceUp_Click" />
                        <Button Content="Move down"
                                Click="MoveSourceDown_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="9">
            <TextBlock DockPanel.Dock="Top"
                       Text="Optional font overrides (engine ID or family → installed family or font file)"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5" />
            <DataGrid x:Name="FontMappingsGrid"
                      ItemsSource="{Binding FontMappings}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      HeadersVisibility="Column"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource TextBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Engine font"
                                        Binding="{Binding EngineId}"
                                        Width="220" />
                    <DataGridTextColumn Header="Installed family or .ttf/.otf path"
                                        Binding="{Binding Mapping}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Row="10" Margin="0,13,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Text="PAKs and RPACKs are indexed read-only. The editor never modifies the game install." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" MinWidth="85" />
                <Button Content="OK"
                        IsDefault="True"
                        MinWidth="85"
                        Click="Ok_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
