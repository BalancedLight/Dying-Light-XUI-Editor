<Window x:Class="XuiEditor.Wpf.AssetRootsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.Xaml.AssetRootsWindow.001}"
        Width="900"
        Height="700"
        MinWidth="720"
        MinHeight="560"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{DynamicResource Ui.Xaml.AssetRootsWindow.002}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InstallText"
                     Grid.Column="0"
                     TextChanged="InstallText_TextChanged"
                     ToolTip="{DynamicResource Ui.Xaml.AssetRootsWindow.003}" />
            <Button Grid.Column="1"
                    Content="{DynamicResource Ui.Xaml.AssetRootsWindow.004}"
                    Margin="7,0,0,0"
                    Click="BrowseInstall_Click" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{DynamicResource Ui.Xaml.AssetRootsWindow.005}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <ComboBox x:Name="LocaleCombo"
                      Grid.Column="1"
                      IsEditable="False"
                      ToolTip="{DynamicResource Ui.Xaml.AssetRootsWindow.006}" />
            <TextBlock Grid.Column="3"
                       Text="{DynamicResource Ui.Xaml.AssetRootsWindow.007}"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <ComboBox x:Name="InputGlyphCombo"
                      Grid.Column="4"
                      ToolTip="{DynamicResource Ui.Xaml.AssetRootsWindow.008}" />
            <TextBlock x:Name="InstallValidationText"
                       Grid.Column="5"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       Foreground="{StaticResource MutedTextBrush}" />
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{DynamicResource Ui.Xaml.AssetRootsWindow.009}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,5" />
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WorkspaceText"
                     Grid.Column="0"
                     ToolTip="{DynamicResource Ui.Xaml.AssetRootsWindow.010}" />
            <Button Grid.Column="1"
                    Content="{DynamicResource Ui.Xaml.AssetRootsWindow.011}"
                    Margin="7,0,0,0"
                    Click="BrowseWorkspace_Click" />
        </Grid>

        <TabControl Grid.Row="7">
            <TabItem Header="{DynamicResource Ui.Xaml.AssetRootsWindow.012}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource Ui.Xaml.AssetRootsWindow.013}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5" />
                        <DataGrid x:Name="RootsGrid"
                                  ItemsSource="{Binding Roots}"
                                  SelectedIndex="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  Background="{StaticResource PanelBrush}"
                                  Foreground="{StaticResource TextBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Ui.Xaml.AssetRootsWindow.014}"
                                                    Binding="{Binding Path}"
                                                    Width="*" />
                                <DataGridComboBoxColumn Header="{DynamicResource Ui.Xaml.AssetRootsWindow.015}"
                                                        SelectedItemBinding="{Binding Kind}"
                                                        Width="160" />
                                <DataGridCheckBoxColumn Header="{DynamicResource Ui.Xaml.AssetRootsWindow.016}"
                                                        Binding="{Binding IsReadOnly}"
                                                        Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Margin="9,26,0,0">
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.017}"
                                ToolTip="{DynamicResource Ui.Xaml.AssetRootsWindow.018}"
                                Click="AddProject_Click" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.019}"
                                Click="AddLooseResources_Click" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.020}"
                                Click="AddLoose_Click" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.021}"
                                Click="AddExtracted_Click" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.022}" Click="Remove_Click" />
                        <Separator Margin="3,8" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.023}" Click="MoveUp_Click" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.024}" Click="MoveDown_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Ui.Xaml.AssetRootsWindow.025}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{DynamicResource Ui.Xaml.AssetRootsWindow.026}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,0,0,5" />
                        <DataGrid x:Name="SourcesGrid"
                                  ItemsSource="{Binding AdditionalSources}"
                                  SelectedIndex="0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  SelectionMode="Single"
                                  Background="{StaticResource PanelBrush}"
                                  Foreground="{StaticResource TextBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Ui.Xaml.AssetRootsWindow.027}"
                                                    Binding="{Binding Path}"
                                                    Width="*" />
                                <DataGridTextColumn Header="{DynamicResource Ui.Xaml.AssetRootsWindow.028}"
                                                    Binding="{Binding DisplayKind}"
                                                    IsReadOnly="True"
                                                    Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Margin="9,26,0,0">
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.029}"
                                ToolTip="{DynamicResource Ui.Xaml.AssetRootsWindow.030}"
                                Click="AddTextureDefinitions_Click" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.031}"
                                ToolTip="{DynamicResource Ui.Xaml.AssetRootsWindow.032}"
                                Click="AddRpack_Click" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.033}"
                                Click="RemoveSource_Click" />
                        <Separator Margin="3,8" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.034}"
                                Click="MoveSourceUp_Click" />
                        <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.035}"
                                Click="MoveSourceDown_Click" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="9">
            <TextBlock DockPanel.Dock="Top"
                       Text="{DynamicResource Ui.Xaml.AssetRootsWindow.036}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5" />
            <DataGrid x:Name="FontMappingsGrid"
                      ItemsSource="{Binding FontMappings}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      HeadersVisibility="Column"
                      Background="{StaticResource PanelBrush}"
                      Foreground="{StaticResource TextBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Ui.Xaml.AssetRootsWindow.037}"
                                        Binding="{Binding EngineId}"
                                        Width="220" />
                    <DataGridTextColumn Header="{DynamicResource Ui.Xaml.AssetRootsWindow.038}"
                                        Binding="{Binding Mapping}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Row="10" Margin="0,13,0,0">
            <TextBlock DockPanel.Dock="Left"
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Text="{DynamicResource Ui.Xaml.AssetRootsWindow.039}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource Ui.Xaml.AssetRootsWindow.040}" IsCancel="True" MinWidth="85" />
                <Button x:Name="AcceptButton"
                        Content="{DynamicResource Ui.Xaml.AssetRootsWindow.041}"
                        IsDefault="True"
                        MinWidth="85"
                        Click="Ok_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
