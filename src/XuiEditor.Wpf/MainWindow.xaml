<Window x:Class="XuiEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:XuiEditor.Wpf.Controls"
        xmlns:models="clr-namespace:XuiEditor.Wpf.Models"
        Title="Dying Light XUI Editor"
        Width="1500"
        Height="930"
        MinWidth="1050"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <CollectionViewSource x:Key="InspectorView"
                              Source="{Binding InspectorProperties}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="CompactButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CompactBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CompactBorder"
                                        Property="Background"
                                        Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CompactBorder"
                                        Property="Background"
                                        Value="Transparent" />
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HierarchyToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#8DC5E8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="HierarchyVisibilityToggle"
               TargetType="CheckBox"
               BasedOn="{StaticResource HierarchyToggle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Viewbox Width="15"
                                     Height="15"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid Width="16" Height="16">
                                    <Path Data="M1,8 C3.4,4.2 6,3 8,3 C10,3 12.6,4.2 15,8 C12.6,11.8 10,13 8,13 C6,13 3.4,11.8 1,8 Z"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round" />
                                    <Ellipse Width="4.5"
                                             Height="4.5"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Fill="{TemplateBinding Foreground}" />
                                    <Path x:Name="VisibilitySlash"
                                          Visibility="Collapsed"
                                          Data="M2,2 L14,14"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="2.1"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path x:Name="VisibilityAncestorMarker"
                                          Visibility="Collapsed"
                                          Data="M11,1 L15,1 L15,5"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding VisibilityState}"
                                         Value="{x:Static models:HierarchyVisibilityState.Hidden}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="VisibilitySlash"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VisibilityState}"
                                         Value="{x:Static models:HierarchyVisibilityState.HiddenByAncestor}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource MutedTextBrush}" />
                                <Setter TargetName="VisibilitySlash"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter TargetName="VisibilityAncestorMarker"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="#42301F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="#8DC5E8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HierarchyLockToggle"
               TargetType="CheckBox"
               BasedOn="{StaticResource HierarchyToggle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Viewbox Width="15"
                                     Height="15"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid Width="16" Height="16">
                                    <Path Data="M3,7 L13,7 L13,15 L3,15 Z"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round" />
                                    <Path x:Name="OpenShackle"
                                          Data="M5,7 L5,5 C5,2.5 7,1.5 9,1.5 C11,1.5 12.5,3 12.5,5"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path x:Name="ClosedShackle"
                                          Visibility="Collapsed"
                                          Data="M5,7 L5,5 C5,2.5 6.5,1.5 8,1.5 C9.5,1.5 11,2.5 11,5 L11,7"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path x:Name="LockAncestorMarker"
                                          Visibility="Collapsed"
                                          Data="M11,1 L15,1 L15,5"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding LockState}"
                                         Value="{x:Static models:HierarchyLockState.Locked}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="OpenShackle"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                <Setter TargetName="ClosedShackle"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LockState}"
                                         Value="{x:Static models:HierarchyLockState.LockedByAncestor}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource MutedTextBrush}" />
                                <Setter TargetName="OpenShackle"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                <Setter TargetName="ClosedShackle"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter TargetName="LockAncestorMarker"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="#42301F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="#8DC5E8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaneHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="TimelineRow" Height="250" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O"
                          Click="Open_Click" />
                <MenuItem Header="Open _Stock XUI…"
                          Click="OpenStock_Click" />
                <MenuItem x:Name="RecentFilesMenu" Header="Open _Recent" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S"
                          Click="Save_Click" />
                <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S"
                          Click="SaveAs_Click" />
                <MenuItem x:Name="ExportPngMenuItem"
                          Header="Export Transparent _PNG…"
                          ToolTip="Export the current visible XUI at 2× design resolution with transparency"
                          Click="ExportPng_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenuItem" Header="_Undo"
                          InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem x:Name="RedoMenuItem" Header="_Redo"
                          InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D"
                          Click="Duplicate_Click" />
                <MenuItem Header="_Delete" InputGestureText="Delete"
                          Click="Delete_Click" />
                <Separator />
                <MenuItem x:Name="CopyInspectorPropertiesMenuItem"
                          Header="Copy Authored _Properties"
                          InputGestureText="Ctrl+C"
                          Click="CopyInspectorProperties_Click" />
                <MenuItem x:Name="AdvancedCopyInspectorPropertiesMenuItem"
                          Header="Advanced Copy Properties…"
                          InputGestureText="Ctrl+Shift+C"
                          Click="AdvancedCopyInspectorProperties_Click" />
                <MenuItem x:Name="PasteInspectorPropertiesMenuItem"
                          Header="Paste Applicable Properties"
                          InputGestureText="Ctrl+V"
                          Click="PasteInspectorProperties_Click" />
                <Separator />
                <MenuItem Header="Move _Up" InputGestureText="Alt+Up"
                          Click="MoveUp_Click" />
                <MenuItem Header="Move _Down" InputGestureText="Alt+Down"
                          Click="MoveDown_Click" />
                <MenuItem Header="_Indent under Previous" InputGestureText="Alt+Right"
                          Click="Indent_Click" />
                <MenuItem Header="_Outdent" InputGestureText="Alt+Left"
                          Click="Outdent_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="GridMenuItem" Header="Show _Grid"
                          IsCheckable="True" Click="Grid_Click" />
                <MenuItem x:Name="SafeAreaMenuItem" Header="Show _Safe Area"
                          IsCheckable="True" Click="SafeArea_Click" />
                <MenuItem x:Name="BoundsMenuItem" Header="Unknown-control _Bounds"
                          IsCheckable="True" Click="Bounds_Click" />
                <MenuItem x:Name="SnapMenuItem" Header="_Snap to Grid"
                          IsCheckable="True" Click="Snap_Click" />
                <MenuItem Header="Grid Settings..."
                          Click="GridSettings_Click" />
                <Separator />
                <MenuItem Header="Select Parent Group"
                          Click="SelectParentGroup_Click" />
                <MenuItem x:Name="ParentMaskMenuItem"
                          Header="Parent-bounds Mask"
                          IsCheckable="True"
                          Click="ParentMask_Click" />
                <MenuItem x:Name="GrayOutsideGroupMenuItem"
                          Header="Gray Outside Selected Group"
                          IsCheckable="True"
                          Click="GrayOutsideGroup_Click" />
                <MenuItem x:Name="DesignTimeMenuItem"
                          Header="Show Design-time Elements"
                          IsCheckable="True"
                          Click="DesignTime_Click" />
                <MenuItem x:Name="NavigationMenuItem"
                          Header="Show Navigation Connections"
                          IsCheckable="True"
                          Click="Navigation_Click" />
                <MenuItem x:Name="NavigationAllMenuItem"
                          Header="Navigation: Show All"
                          IsCheckable="True"
                          Click="NavigationAll_Click" />
                <Separator />
                <MenuItem Header="_Fit Canvas" InputGestureText="F"
                          Click="Fit_Click" />
                <MenuItem Header="_100%" InputGestureText="0"
                          Click="ActualPixels_Click" />
                <MenuItem Header="Zoom _In" InputGestureText="+"
                          Click="ZoomIn_Click" />
                <MenuItem Header="Zoom _Out" InputGestureText="-"
                          Click="ZoomOut_Click" />
                <Separator />
                <MenuItem Header="Load _Reference Image…"
                          Click="LoadReferenceImage_Click" />
                <MenuItem Header="Clear Reference Image"
                          Click="ClearReferenceImage_Click" />
                <MenuItem Header="Force-show Selection"
                          Click="ForceShowSelected_Click" />
                <MenuItem x:Name="ForceShowGroupMenuItem"
                          Header="Force-show Current Group"
                          IsCheckable="True"
                          Click="ForceShowCurrentGroup_Click" />
                <MenuItem Header="Force-show All"
                          Click="ForceShowAll_Click" />
                <MenuItem Header="Clear Force-show"
                          Click="ClearForceShown_Click" />
            </MenuItem>
            <MenuItem Header="_Animation">
                <MenuItem Header="_Play / Pause" InputGestureText="Space"
                          Click="PlayPause_Click" />
                <MenuItem Header="_Stop" Click="Stop_Click" />
                <MenuItem Header="Previous Tick" InputGestureText=","
                          Click="PreviousTick_Click" />
                <MenuItem Header="Next Tick" InputGestureText="."
                          Click="NextTick_Click" />
                <Separator />
                <MenuItem Header="Add _Keyframe" Click="AddKeyFrame_Click" />
                <MenuItem Header="Delete Keyframe" Click="DeleteKeyFrame_Click" />
                <MenuItem Header="_Copy Keyframe" InputGestureText="Ctrl+Alt+C"
                          Click="CopyKeyFrame_Click" />
                <MenuItem Header="_Paste Keyframe" InputGestureText="Ctrl+Alt+V"
                          Click="PasteKeyFrame_Click" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Dying Light _Resources…"
                          ToolTip="Configure the install, project folders, loose resources, texture definitions, and RPACKs"
                          Click="AssetRoots_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="5,3">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Open" ToolTip="Open XUI (Ctrl+O)"
                            Click="Open_Click" />
                    <Button Content="Stock"
                            ToolTip="Browse read-only stock XUIs from the selected game install"
                            Click="OpenStock_Click" />
                    <Button Content="Save" ToolTip="Save (Ctrl+S)"
                            Click="Save_Click" />
                    <Separator Margin="5,3" />
                    <Button Content="Undo" ToolTip="Undo (Ctrl+Z)"
                            Click="Undo_Click" />
                    <Button Content="Redo" ToolTip="Redo (Ctrl+Y)"
                            Click="Redo_Click" />
                    <Separator Margin="5,3" />
                    <Button Content="Fit" ToolTip="Fit canvas (F)"
                            Click="Fit_Click" />
                    <Button Content="100%" ToolTip="Actual pixels (0)"
                            Click="ActualPixels_Click" />
                    <Button Content="−" ToolTip="Zoom out"
                            Click="ZoomOut_Click" />
                    <Button Content="+" ToolTip="Zoom in"
                            Click="ZoomIn_Click" />
                    <Separator Margin="5,3" />
                    <Button x:Name="ExportPngButton"
                            Content="PNG"
                            ToolTip="Export a transparent 2× PNG of the current visible XUI"
                            Click="ExportPng_Click" />
                    <Separator Margin="5,3" />
                    <ToggleButton x:Name="ToolbarSnap"
                                  Content="Snap"
                                  Padding="10,5"
                                  Margin="2"
                                  Checked="ToolbarSnap_Changed"
                                  Unchecked="ToolbarSnap_Changed" />
                    <Separator Margin="5,3" />
                    <TextBlock Text="Reference"
                               Margin="4,0,3,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <Slider x:Name="ReferenceOpacitySlider"
                            Width="72"
                            Minimum="0"
                            Maximum="1"
                            ToolTip="Reference image opacity"
                            ValueChanged="ReferenceOpacitySlider_ValueChanged" />
                </StackPanel>
                <TextBlock x:Name="DocumentPathText"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Right"
                           Margin="12,0,5,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HierarchyColumn" Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="InspectorColumn" Width="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button x:Name="CollapseHierarchyButton"
                                        Style="{StaticResource CompactButton}"
                                        Content="Collapse"
                                        Margin="0,0,5,0"
                                        ToolTip="Collapse all hierarchy branches"
                                        Click="CollapseHierarchy_Click" />
                                <Button x:Name="RevealHierarchyButton"
                                        Style="{StaticResource CompactButton}"
                                        Content="Reveal"
                                        ToolTip="Reveal the current canvas selection"
                                        Click="RevealHierarchySelection_Click" />
                                <TextBlock x:Name="HierarchyCountText"
                                           Margin="7,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Hierarchy"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="BreadcrumbText"
                               DockPanel.Dock="Top"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,6,8,2" />
                    <TextBox x:Name="HierarchySearch"
                             DockPanel.Dock="Top"
                             Margin="7,5,7,7"
                             ToolTip="Filter by Id, type, Visual, or ClassOverride"
                             TextChanged="HierarchySearch_TextChanged" />
                    <ListBox x:Name="HierarchyList"
                             ItemsSource="{Binding HierarchyRows}"
                             SelectionMode="Extended"
                             SelectionChanged="HierarchyList_SelectionChanged"
                             KeyDown="HierarchyList_KeyDown"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Height" Value="24" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:HierarchyRow}">
                                <Grid Height="24">
                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Opened="HierarchyContextMenu_Opened">
                                            <MenuItem Header="Add child..."
                                                      InputGestureText="Ctrl+Insert"
                                                      Click="HierarchyAddChild_Click" />
                                            <Separator />
                                            <MenuItem Header="Hide all except this"
                                                      ToolTip="Isolate this item and its descendants"
                                                      Click="HierarchyIsolate_Click" />
                                            <MenuItem Header="Restore visibility before isolate"
                                                      Tag="RestoreIsolation"
                                                      Click="HierarchyRestoreIsolation_Click" />
                                            <Separator />
                                            <MenuItem Header="Show all"
                                                      Click="HierarchyShowAll_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="23" />
                                        <ColumnDefinition Width="23" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="{Binding Indent}" />
                                    <Button Grid.Column="1"
                                            Tag="{Binding}"
                                            Click="HierarchyExpand_Click"
                                            IsEnabled="{Binding HasChildren}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource CompactButton}">
                                                <Setter Property="Content" Value="›" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}"
                                                                 Value="True">
                                                        <Setter Property="Content" Value="⌄" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasChildren}"
                                                                 Value="False">
                                                        <Setter Property="Content" Value="" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Opacity="{Binding RowTextOpacity}">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ElementName, StringFormat=  · {0}}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="3"
                                              Style="{StaticResource HierarchyVisibilityToggle}"
                                              Tag="{Binding}"
                                              IsChecked="{Binding IsEditorVisible}"
                                              IsEnabled="{Binding CanToggleVisibility}"
                                              Click="HierarchyVisibility_Click"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding VisibilityToolTip}"
                                              ToolTipService.ShowOnDisabled="True"
                                              AutomationProperties.Name="{Binding VisibilityAutomationName}" />
                                    <CheckBox Grid.Column="4"
                                              Style="{StaticResource HierarchyLockToggle}"
                                              Tag="{Binding}"
                                              IsChecked="{Binding IsLocked}"
                                              IsEnabled="{Binding CanToggleLock}"
                                              Click="HierarchyLock_Click"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding LockToolTip}"
                                              ToolTipService.ShowOnDisabled="True"
                                              AutomationProperties.Name="{Binding LockAutomationName}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <controls:XuiViewportControl x:Name="Viewport"
                                             AllowDrop="True"
                                             SelectionRequested="Viewport_SelectionRequested"
                                             TransformCommitted="Viewport_TransformCommitted"
                                             NavigationEditRequested="Viewport_NavigationEditRequested"
                                             DragOver="Viewport_AssetDragOver"
                                             DragLeave="Viewport_AssetDragLeave"
                                             Drop="Viewport_AssetDrop" />
                <Grid x:Name="ViewportLoadingOverlay"
                      Panel.ZIndex="100"
                      Background="#F0000000"
                      Visibility="Collapsed"
                      IsHitTestVisible="True">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <controls:AnimatedGifImage x:Name="LoadingGears"
                                                   Width="176"
                                                   Height="176"
                                                   Stretch="Uniform"
                                                   SourceUri="/DyingLightXuiEditor;component/Assets/MovingGears.gif"
                                                   AutomationProperties.Name="Loading animation" />
                        <TextBlock Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="Loading XUI and assets..." />
                    </StackPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Margin="8,-3,0,-3">
                                <TextBlock x:Name="SelectionCountText"
                                           Margin="0,0,6,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                                <ToggleButton x:Name="AdvancedInspectorToggle"
                                              Content="Advanced"
                                              Margin="0,0,4,0"
                                              Padding="8,2"
                                              ToolTip="Show the full inherited Chrome 6 property schema"
                                              Click="AdvancedInspector_Click" />
                                <Button x:Name="AddPropertyButton"
                                        Content="+ Property"
                                        Margin="0,0,4,0"
                                        Padding="8,2"
                                        ToolTip="Add an authored property to the selected element"
                                        Click="AddProperty_Click" />
                                <Button x:Name="AddParentButton"
                                        Content="+ Parent"
                                        Margin="0,0,4,0"
                                        Padding="8,2"
                                        ToolTip="Wrap the selected element in a new parent"
                                        Click="AddParent_Click" />
                                <Button x:Name="AddChildButton"
                                        Content="+ Child"
                                        Padding="8,2"
                                        ToolTip="Add a visual child to the selected element (Ctrl+Insert)"
                                        Click="AddChild_Click" />
                            </StackPanel>
                            <TextBlock Text="Inspector"
                                       FontWeight="SemiBold" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top"
                            Padding="8,5"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button x:Name="CopyInspectorPropertiesButton"
                                        Content="Copy"
                                        Padding="8,2"
                                        ToolTip="Copy all authored properties except Id and ClassOverride (Ctrl+C)"
                                        Click="CopyInspectorProperties_Click" />
                                <Button x:Name="AdvancedCopyInspectorPropertiesButton"
                                        Content="Copy…"
                                        Padding="8,2"
                                        ToolTip="Choose authored properties or inherited defaults to copy (Ctrl+Shift+C)"
                                        Click="AdvancedCopyInspectorProperties_Click" />
                                <Button x:Name="PasteInspectorPropertiesButton"
                                        Content="Paste"
                                        Padding="8,2"
                                        ToolTip="Paste only properties applicable to the selected destination elements (Ctrl+V)"
                                        Click="PasteInspectorProperties_Click" />
                            </StackPanel>
                            <TextBlock x:Name="PropertyClipboardText"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="No copied properties"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="InspectorHint"
                                   Margin="9,7"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="Select an element to edit its authored properties." />
                        <Expander x:Name="TextStyleExpander"
                                  Header="Semantic text style"
                                  Margin="8,0,8,4"
                                  Visibility="Collapsed"
                                  IsExpanded="True">
                            <StackPanel Margin="5,4,0,5">
                                <WrapPanel>
                                    <CheckBox x:Name="TextBoldCheckBox"
                                              Content="Bold"
                                              Margin="0,0,10,3"
                                              Click="TextStyleFlag_Click" />
                                    <CheckBox x:Name="TextItalicCheckBox"
                                              Content="Italic"
                                              Margin="0,0,10,3"
                                              Click="TextStyleFlag_Click" />
                                    <CheckBox x:Name="TextUnderlineCheckBox"
                                              Content="Underline"
                                              Margin="0,0,10,3"
                                              Click="TextStyleFlag_Click" />
                                </WrapPanel>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Horizontal"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox x:Name="TextHorizontalComboBox"
                                              Grid.Column="1"
                                              SelectionChanged="TextHorizontal_SelectionChanged">
                                        <ComboBoxItem Content="Unspecified" Tag="Unspecified" />
                                        <ComboBoxItem Content="Left" Tag="Left" />
                                        <ComboBoxItem Content="Center" Tag="Center" />
                                        <ComboBoxItem Content="Right" Tag="Right" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="2"
                                               Text="Vertical"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox x:Name="TextVerticalComboBox"
                                              Grid.Column="3"
                                              SelectionChanged="TextVertical_SelectionChanged">
                                        <ComboBoxItem Content="Top" Tag="Top" />
                                        <ComboBoxItem Content="Middle" Tag="Middle" />
                                        <ComboBoxItem Content="Bottom" Tag="Bottom" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="TextStyleRawText"
                                           Margin="0,5,0,0"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="PivotExpander"
                                  Header="Pivot"
                                  Margin="8,0,8,5"
                                  Visibility="Collapsed"
                                  IsExpanded="True">
                            <StackPanel Margin="5,4,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="X" VerticalAlignment="Center" />
                                    <TextBox x:Name="PivotXTextBox"
                                             Grid.Column="1"
                                             LostKeyboardFocus="PivotValue_LostKeyboardFocus"
                                             KeyDown="PivotValue_KeyDown" />
                                    <TextBlock Grid.Column="2" Text="Y"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="PivotYTextBox"
                                             Grid.Column="3"
                                             LostKeyboardFocus="PivotValue_LostKeyboardFocus"
                                             KeyDown="PivotValue_KeyDown" />
                                    <TextBlock Grid.Column="4" Text="Z"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="PivotZTextBox"
                                             Grid.Column="5"
                                             LostKeyboardFocus="PivotValue_LostKeyboardFocus"
                                             KeyDown="PivotValue_KeyDown" />
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,5,0,0">
                                    <Button Content="↖" Tag="TopLeft"
                                            ToolTip="Top left"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↑" Tag="TopCenter"
                                            ToolTip="Top center"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↗" Tag="TopRight"
                                            ToolTip="Top right"
                                            Click="PivotPreset_Click" />
                                    <Button Content="←" Tag="MiddleLeft"
                                            ToolTip="Middle left"
                                            Click="PivotPreset_Click" />
                                    <Button Content="•" Tag="Center"
                                            ToolTip="Center"
                                            Click="PivotPreset_Click" />
                                    <Button Content="→" Tag="MiddleRight"
                                            ToolTip="Middle right"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↙" Tag="BottomLeft"
                                            ToolTip="Bottom left"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↓" Tag="BottomCenter"
                                            ToolTip="Bottom center"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↘" Tag="BottomRight"
                                            ToolTip="Bottom right"
                                            Click="PivotPreset_Click" />
                                </UniformGrid>
                                <Button Content="Reset pivot to origin"
                                        Tag="Origin"
                                        Margin="0,4,0,0"
                                        ToolTip="Reset X and Y to zero while preserving Z"
                                        Click="PivotPreset_Click" />
                                <CheckBox x:Name="PreservePivotPositionCheckBox"
                                          Margin="0,5,0,0"
                                          Content="Preserve visual position"
                                          ToolTip="Compensate Position while Scale and Rotation are static"
                                          Click="PreservePivotPosition_Click" />
                                <TextBlock x:Name="PivotStatusText"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <Expander x:Name="RawXmlExpander"
                              DockPanel.Dock="Bottom"
                              Header="Raw XML"
                              Visibility="Collapsed"
                              Expanded="RawXmlExpander_Expanded"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,1,0,0"
                              Padding="8,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="150" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0"
                                       Margin="0,0,0,5">
                                <Button x:Name="LoadLargeRawXmlButton"
                                        DockPanel.Dock="Right"
                                        Content="Load large XML"
                                        Visibility="Collapsed"
                                        Click="LoadLargeRawXml_Click" />
                                <TextBlock x:Name="RawXmlStatusText"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="RawXmlTextBox"
                                     Grid.Row="1"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     SpellCheck.IsEnabled="False" />
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,5,0,0">
                                <Button x:Name="ResetRawXmlButton"
                                        Content="Reset"
                                        Click="ResetRawXml_Click" />
                                <Button x:Name="ApplyRawXmlButton"
                                        Content="Apply XML"
                                        Click="ApplyRawXml_Click" />
                            </StackPanel>
                            <TextBlock x:Name="RawXmlErrorText"
                                       Grid.Row="3"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </Expander>
                    <ListBox x:Name="InspectorList"
                             ItemsSource="{Binding Source={StaticResource InspectorView}}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="InspectorList_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,1"
                                                Padding="8,5"
                                                Margin="0,5,0,2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:InspectorPropertyRow}">
                                <Grid Margin="8,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="25" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               ToolTip="{Binding ToolTip}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                             Tag="{Binding}"
                                             LostFocus="InspectorValue_LostFocus"
                                             KeyDown="InspectorValue_KeyDown"
                                             ToolTip="{Binding Error}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox"
                                                   BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGhostDefault}"
                                                                 Value="True">
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                        <Setter Property="Opacity" Value="0.68" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasChoices}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBooleanToggle}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="BorderThickness"
                                                                Value="1.5" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMixed}"
                                                                 Value="True">
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource MutedTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Choices}"
                                              Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Tag="{Binding}"
                                              DropDownClosed="InspectorChoice_DropDownClosed"
                                              LostKeyboardFocus="InspectorChoice_LostKeyboardFocus"
                                              KeyDown="InspectorChoice_KeyDown"
                                              ToolTip="{Binding Error}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox"
                                                   BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChoices}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="BorderThickness"
                                                                Value="1.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <CheckBox Grid.Column="1"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsThreeState="{Binding IsMixed}"
                                              IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Tag="{Binding}"
                                              ToolTip="{Binding Error}"
                                              AutomationProperties.Name="{Binding Name}"
                                              Click="InspectorBoolean_Click">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox"
                                                   BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBooleanToggle}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <Button Grid.Column="2"
                                            Content="⧉"
                                            FontFamily="Segoe UI Symbol"
                                            Padding="2,0"
                                            Margin="3,0,0,0"
                                            Tag="{Binding}"
                                            ToolTip="Copy only this property value"
                                            AutomationProperties.Name="Copy property"
                                            Click="InspectorCopySingleProperty_Click" />
                                    <Button Grid.Column="3"
                                            Content="×"
                                            Padding="2,0"
                                            Margin="3,0,0,0"
                                            Tag="{Binding}"
                                            ToolTip="Reset to the inherited default by removing the authored property"
                                            Click="InspectorReset_Click">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanReset}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <TabControl Grid.Row="4">
            <TabItem x:Name="AnimationTab" Header="Animation">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="5,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="TimelineTransportPanel"
                                            Orientation="Horizontal"
                                            Grid.Column="0"
                                            VerticalAlignment="Top">
                                    <TextBlock x:Name="TimelineScopeText"
                                               MinWidth="150"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="2,0,8,0"
                                               Text="No timeline scope" />
                                    <Button x:Name="PlayPauseButton"
                                            Content="Play"
                                            Click="PlayPause_Click" />
                                    <Button Content="Stop" Click="Stop_Click" />
                                    <Button Content="‹ Tick" Click="PreviousTick_Click" />
                                    <Button Content="Tick ›" Click="NextTick_Click" />
                                    <CheckBox x:Name="LoopCheckBox"
                                              Content="Loop"
                                              IsChecked="True"
                                              VerticalAlignment="Center"
                                              Margin="9,0" />
                                    <ToggleButton x:Name="AllTracksToggle"
                                                  Content="All in scope"
                                                  ToolTip="Show every target owned by the active timeline scope"
                                                  Checked="AllTracksToggle_Changed"
                                                  Unchecked="AllTracksToggle_Changed" />
                                    <TextBlock Text="Speed"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,4,0" />
                                    <ComboBox x:Name="SpeedComboBox"
                                              Width="72"
                                              SelectedIndex="2">
                                        <ComboBoxItem Content="0.25×" Tag="0.25" />
                                        <ComboBoxItem Content="0.5×" Tag="0.5" />
                                        <ComboBoxItem Content="1×" Tag="1" />
                                        <ComboBoxItem Content="2×" Tag="2" />
                                        <ComboBoxItem Content="4×" Tag="4" />
                                    </ComboBox>
                                    <Separator Margin="5,3" />
                                    <Button Content="+ Key" Click="AddKeyFrame_Click" />
                                    <Button Content="Delete Key" Click="DeleteKeyFrame_Click" />
                                    <Button Content="Copy" Click="CopyKeyFrame_Click" />
                                    <Button Content="Paste" Click="PasteKeyFrame_Click" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                    <TextBlock x:Name="TickText"
                                               VerticalAlignment="Center"
                                               Margin="8,0"
                                               FontFamily="Consolas" />
                                    <Slider x:Name="TickSlider"
                                            Width="300"
                                            Minimum="0"
                                            Maximum="1"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            ValueChanged="TickSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="PreviewStatePanel"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    MaxWidth="440"
                                    HorizontalAlignment="Right"
                                    Margin="8,4,0,0"
                                    Padding="6,4"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                Margin="7,0,0,0">
                                        <Button x:Name="ForceShowInspectorButton"
                                                Content="Force show"
                                                Padding="7,2"
                                                Margin="0,0,4,0"
                                                Click="ForceShowSelected_Click" />
                                        <Button x:Name="RestoreComposedPoseButton"
                                                Content="Composed pose"
                                                Padding="7,2"
                                                ToolTip="Return the active animation scope to its automatically composed visible pose"
                                                Click="RestoreComposedPose_Click" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Effective preview state"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock x:Name="PreviewStateText"
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <WrapPanel x:Name="TimelineEditPanel"
                                       Grid.Row="2"
                                       Margin="0,4,0,0">
                                <TextBlock Text="Selected key"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <TextBlock x:Name="KeyPropertyText"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <TextBox x:Name="KeyValueTextBox"
                                         Width="145"
                                         IsEnabled="False"
                                         ToolTip="Value for the selected property track"
                                         LostKeyboardFocus="KeyFrameValue_LostKeyboardFocus"
                                         KeyDown="KeyFrameValue_KeyDown" />
                                <ComboBox x:Name="KeyInterpolationComboBox"
                                          Width="88"
                                          Margin="5,0,0,0"
                                          IsEnabled="False"
                                          SelectionChanged="KeyInterpolation_SelectionChanged">
                                    <ComboBoxItem Content="Linear" Tag="0" />
                                    <ComboBoxItem Content="Eased" Tag="2" />
                                </ComboBox>
                                <TextBlock Text="In" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBox x:Name="EaseInTextBox"
                                         Width="48"
                                         IsEnabled="False"
                                         LostKeyboardFocus="KeyFrameEase_LostKeyboardFocus"
                                         KeyDown="KeyFrameEase_KeyDown" />
                                <TextBlock Text="Out" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBox x:Name="EaseOutTextBox"
                                         Width="48"
                                         IsEnabled="False"
                                         LostKeyboardFocus="KeyFrameEase_LostKeyboardFocus"
                                         KeyDown="KeyFrameEase_KeyDown" />
                                <TextBlock Text="Scale" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBox x:Name="EaseScaleTextBox"
                                         Width="48"
                                         IsEnabled="False"
                                         LostKeyboardFocus="KeyFrameEase_LostKeyboardFocus"
                                         KeyDown="KeyFrameEase_KeyDown" />
                                <TextBlock x:Name="KeyValueErrorText"
                                           Foreground="{StaticResource DangerBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                                <Separator Margin="8,3" />
                                <TextBlock Text="Named frame"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <ComboBox x:Name="NamedFrameComboBox"
                                          Width="132"
                                          SelectionChanged="NamedFrame_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox x:Name="NamedFrameNameTextBox"
                                         Width="110"
                                         Margin="4,0,0,0"
                                         ToolTip="Name" />
                                <TextBox x:Name="NamedFrameTickTextBox"
                                         Width="52"
                                         Margin="4,0,0,0"
                                         ToolTip="Tick" />
                                <ComboBox x:Name="NamedFrameCommandComboBox"
                                          Width="112"
                                          Margin="4,0,0,0"
                                          IsEditable="True"
                                          ToolTip="Command">
                                    <ComboBoxItem Content="" />
                                    <ComboBoxItem Content="stop" />
                                    <ComboBoxItem Content="goto" />
                                    <ComboBoxItem Content="gotoandstop" />
                                    <ComboBoxItem Content="gotoandplay" />
                                </ComboBox>
                                <TextBox x:Name="NamedFrameTargetTextBox"
                                         Width="105"
                                         Margin="4,0,0,0"
                                         ToolTip="Command target" />
                                <Button Content="+ Marker" Click="AddNamedFrame_Click" />
                                <Button Content="Go to" Click="GoToNamedFrame_Click" />
                                <Button Content="Apply" Click="ApplyNamedFrame_Click" />
                                <Button Content="Delete" Click="DeleteNamedFrame_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <controls:TimelineEditorControl x:Name="TimelineEditor"
                                                    Grid.Row="1"
                                                    TickChanged="TimelineEditor_TickChanged"
                                                    SelectedKeyFrameChanged="TimelineEditor_SelectedKeyFrameChanged"
                                                    KeyFrameMoveRequested="TimelineEditor_KeyFrameMoveRequested" />
                </Grid>
            </TabItem>
            <TabItem Header="Assets">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,4">
                        <StackPanel>
                            <WrapPanel>
                                <TextBox x:Name="AssetSearchTextBox"
                                         Width="260"
                                         ToolTip="Search screens, visuals, textures, and fonts"
                                         TextChanged="AssetSearch_TextChanged" />
                                <ComboBox x:Name="AssetKindComboBox"
                                          Width="115"
                                          Margin="6,0,0,0"
                                          SelectedIndex="0"
                                          SelectionChanged="AssetKind_SelectionChanged">
                                    <ComboBoxItem Content="All" Tag="All" />
                                    <ComboBoxItem Content="Screens" Tag="Screen" />
                                    <ComboBoxItem Content="Visuals" Tag="Visual" />
                                    <ComboBoxItem Content="Textures" Tag="Texture" />
                                    <ComboBoxItem Content="Fonts" Tag="Font" />
                                </ComboBox>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox x:Name="AutoSizeAssetDropCheckBox"
                                          Content="Auto-size on drop"
                                          VerticalAlignment="Center"
                                          Margin="4,0,8,0"
                                          ToolTip="Explicitly resize an existing image to the texture dimensions when dropping" />
                                <Button Content="Open" Click="AssetOpen_Click" />
                                <Button Content="Copy to Workspace"
                                        Click="AssetCopy_Click" />
                                <Button Content="New Screen"
                                        Click="AssetNewScreen_Click" />
                                <Button Content="New Visual"
                                        Click="AssetNewVisual_Click" />
                                <Button Content="Rename"
                                        Click="AssetRename_Click" />
                                <Button Content="Delete"
                                        Click="AssetDelete_Click" />
                                <Button Content="References / Replace"
                                        Click="AssetReferences_Click" />
                                <Button x:Name="UndoReferenceTransactionButton"
                                        Content="Undo Replace"
                                        IsEnabled="False"
                                        Click="AssetUndoReferenceTransaction_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="AssetList"
                              ItemsSource="{Binding AssetRows}"
                              PreviewMouseLeftButtonDown="AssetList_MouseLeftButtonDown"
                              PreviewMouseMove="AssetList_MouseMove"
                              MouseDoubleClick="AssetList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Kind"
                                                DisplayMemberBinding="{Binding KindLabel}"
                                                Width="85" />
                                <GridViewColumn Header="Name"
                                                DisplayMemberBinding="{Binding Name}"
                                                Width="240" />
                                <GridViewColumn Header="Size"
                                                DisplayMemberBinding="{Binding SizeLabel}"
                                                Width="100" />
                                <GridViewColumn Header="Access"
                                                DisplayMemberBinding="{Binding AccessLabel}"
                                                Width="95" />
                                <GridViewColumn Header="Source"
                                                DisplayMemberBinding="{Binding SourceDisplayPath}"
                                                Width="520" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="Diagnostics">
                <DockPanel>
                    <TextBox x:Name="DiagnosticsSearch"
                             DockPanel.Dock="Top"
                             Margin="7"
                             ToolTip="Filter diagnostics"
                             TextChanged="DiagnosticsSearch_TextChanged" />
                    <DataGrid x:Name="DiagnosticsGrid"
                              ItemsSource="{Binding FilteredDiagnostics}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="{StaticResource PanelBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity"
                                                Binding="{Binding Severity}"
                                                Width="90" />
                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding Code}"
                                                Width="105" />
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                Width="*" />
                            <DataGridTextColumn Header="Node"
                                                Binding="{Binding NodeKey}"
                                                Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="DirtyText" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="DocumentStatsText" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="AssetStatusText" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
