<Window x:Class="XuiEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:XuiEditor.Wpf.Controls"
        xmlns:models="clr-namespace:XuiEditor.Wpf.Models"
        Title="Dying Light XUI Editor"
        Width="1500"
        Height="930"
        MinWidth="1050"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <CollectionViewSource x:Key="InspectorView"
                              Source="{Binding InspectorProperties}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="CompactButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CompactBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CompactBorder"
                                        Property="Background"
                                        Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CompactBorder"
                                        Property="Background"
                                        Value="Transparent" />
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HierarchyToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaneHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="TimelineRow" Height="250" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…" InputGestureText="Ctrl+O"
                          Click="Open_Click" />
                <MenuItem Header="Open _Stock XUI…"
                          Click="OpenStock_Click" />
                <MenuItem x:Name="RecentFilesMenu" Header="Open _Recent" />
                <Separator />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S"
                          Click="Save_Click" />
                <MenuItem Header="Save _As…" InputGestureText="Ctrl+Shift+S"
                          Click="SaveAs_Click" />
                <Separator />
                <MenuItem Header="Dying Light _Data…"
                          Click="AssetRoots_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenuItem" Header="_Undo"
                          InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem x:Name="RedoMenuItem" Header="_Redo"
                          InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D"
                          Click="Duplicate_Click" />
                <MenuItem Header="_Delete" InputGestureText="Delete"
                          Click="Delete_Click" />
                <Separator />
                <MenuItem Header="Move _Up" InputGestureText="Alt+Up"
                          Click="MoveUp_Click" />
                <MenuItem Header="Move _Down" InputGestureText="Alt+Down"
                          Click="MoveDown_Click" />
                <MenuItem Header="_Indent under Previous" InputGestureText="Alt+Right"
                          Click="Indent_Click" />
                <MenuItem Header="_Outdent" InputGestureText="Alt+Left"
                          Click="Outdent_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="GridMenuItem" Header="Show _Grid"
                          IsCheckable="True" Click="Grid_Click" />
                <MenuItem x:Name="SafeAreaMenuItem" Header="Show _Safe Area"
                          IsCheckable="True" Click="SafeArea_Click" />
                <MenuItem x:Name="BoundsMenuItem" Header="Unknown-control _Bounds"
                          IsCheckable="True" Click="Bounds_Click" />
                <MenuItem x:Name="SnapMenuItem" Header="_Snap to Grid"
                          IsCheckable="True" Click="Snap_Click" />
                <Separator />
                <MenuItem Header="_Fit Canvas" InputGestureText="F"
                          Click="Fit_Click" />
                <MenuItem Header="_100%" InputGestureText="0"
                          Click="ActualPixels_Click" />
                <MenuItem Header="Zoom _In" InputGestureText="+"
                          Click="ZoomIn_Click" />
                <MenuItem Header="Zoom _Out" InputGestureText="-"
                          Click="ZoomOut_Click" />
                <Separator />
                <MenuItem Header="Load _Reference Image…"
                          Click="LoadReferenceImage_Click" />
                <MenuItem Header="Clear Reference Image"
                          Click="ClearReferenceImage_Click" />
                <MenuItem Header="Force-show Selection"
                          Click="ForceShowSelected_Click" />
                <MenuItem Header="Clear Force-show"
                          Click="ClearForceShown_Click" />
            </MenuItem>
            <MenuItem Header="_Animation">
                <MenuItem Header="_Play / Pause" InputGestureText="Space"
                          Click="PlayPause_Click" />
                <MenuItem Header="_Stop" Click="Stop_Click" />
                <MenuItem Header="Previous Tick" InputGestureText=","
                          Click="PreviousTick_Click" />
                <MenuItem Header="Next Tick" InputGestureText="."
                          Click="NextTick_Click" />
                <Separator />
                <MenuItem Header="Add _Keyframe" Click="AddKeyFrame_Click" />
                <MenuItem Header="Delete Keyframe" Click="DeleteKeyFrame_Click" />
                <MenuItem Header="_Copy Keyframe" InputGestureText="Ctrl+Alt+C"
                          Click="CopyKeyFrame_Click" />
                <MenuItem Header="_Paste Keyframe" InputGestureText="Ctrl+Alt+V"
                          Click="PasteKeyFrame_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="5,3">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Open" ToolTip="Open XUI (Ctrl+O)"
                            Click="Open_Click" />
                    <Button Content="Stock"
                            ToolTip="Browse read-only stock XUIs from the selected game install"
                            Click="OpenStock_Click" />
                    <Button Content="Save" ToolTip="Save (Ctrl+S)"
                            Click="Save_Click" />
                    <Separator Margin="5,3" />
                    <Button Content="Undo" ToolTip="Undo (Ctrl+Z)"
                            Click="Undo_Click" />
                    <Button Content="Redo" ToolTip="Redo (Ctrl+Y)"
                            Click="Redo_Click" />
                    <Separator Margin="5,3" />
                    <Button Content="Fit" ToolTip="Fit canvas (F)"
                            Click="Fit_Click" />
                    <Button Content="100%" ToolTip="Actual pixels (0)"
                            Click="ActualPixels_Click" />
                    <Button Content="−" ToolTip="Zoom out"
                            Click="ZoomOut_Click" />
                    <Button Content="+" ToolTip="Zoom in"
                            Click="ZoomIn_Click" />
                    <Separator Margin="5,3" />
                    <ToggleButton x:Name="ToolbarSnap"
                                  Content="Snap"
                                  Padding="10,5"
                                  Margin="2"
                                  Checked="ToolbarSnap_Changed"
                                  Unchecked="ToolbarSnap_Changed" />
                    <Separator Margin="5,3" />
                    <TextBlock Text="Preview"
                               Margin="4,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="PreviewScenarioCombo"
                              Width="155"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="Preview scenario"
                              AutomationProperties.AutomationId="PreviewScenarioCombo"
                              ToolTip="Choose representative game-supplied HUD values"
                              SelectionChanged="PreviewScenario_SelectionChanged" />
                    <TextBlock Text="Reference"
                               Margin="7,0,3,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <Slider x:Name="ReferenceOpacitySlider"
                            Width="72"
                            Minimum="0"
                            Maximum="1"
                            ToolTip="Reference image opacity"
                            ValueChanged="ReferenceOpacitySlider_ValueChanged" />
                </StackPanel>
                <TextBlock x:Name="DocumentPathText"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Right"
                           Margin="12,0,5,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HierarchyColumn" Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="InspectorColumn" Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button Style="{StaticResource CompactButton}"
                                        Content="Collapse"
                                        ToolTip="Collapse all hierarchy branches"
                                        Click="CollapseHierarchy_Click" />
                                <Button Style="{StaticResource CompactButton}"
                                        Content="Reveal"
                                        ToolTip="Reveal the current canvas selection"
                                        Click="RevealHierarchySelection_Click" />
                                <TextBlock x:Name="HierarchyCountText"
                                           Margin="7,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Hierarchy"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="BreadcrumbText"
                               DockPanel.Dock="Top"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,6,8,2" />
                    <TextBox x:Name="HierarchySearch"
                             DockPanel.Dock="Top"
                             Margin="7,5,7,7"
                             ToolTip="Filter by Id, type, Visual, or ClassOverride"
                             TextChanged="HierarchySearch_TextChanged" />
                    <ListBox x:Name="HierarchyList"
                             ItemsSource="{Binding HierarchyRows}"
                             SelectionMode="Extended"
                             SelectionChanged="HierarchyList_SelectionChanged"
                             KeyDown="HierarchyList_KeyDown"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Height" Value="24" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:HierarchyRow}">
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="23" />
                                        <ColumnDefinition Width="23" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="{Binding Indent}" />
                                    <Button Grid.Column="1"
                                            Tag="{Binding}"
                                            Click="HierarchyExpand_Click"
                                            IsEnabled="{Binding HasChildren}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource CompactButton}">
                                                <Setter Property="Content" Value="›" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}"
                                                                 Value="True">
                                                        <Setter Property="Content" Value="⌄" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasChildren}"
                                                                 Value="False">
                                                        <Setter Property="Content" Value="" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ElementName, StringFormat=  · {0}}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="3"
                                              Style="{StaticResource HierarchyToggle}"
                                              Tag="{Binding}"
                                              IsChecked="{Binding IsEditorVisible}"
                                              Click="HierarchyVisibility_Click"
                                              Content="V"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="Editor visibility (does not alter XUI)" />
                                    <CheckBox Grid.Column="4"
                                              Style="{StaticResource HierarchyToggle}"
                                              Tag="{Binding}"
                                              IsChecked="{Binding IsLocked}"
                                              Click="HierarchyLock_Click"
                                              Content="L"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="Lock transforms in the editor" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <controls:XuiViewportControl x:Name="Viewport"
                                         Grid.Column="2"
                                         SelectionRequested="Viewport_SelectionRequested"
                                         TransformCommitted="Viewport_TransformCommitted" />

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                        <DockPanel>
                            <TextBlock x:Name="SelectionCountText"
                                       DockPanel.Dock="Right"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="Inspector"
                                       FontWeight="SemiBold" />
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="InspectorHint"
                               DockPanel.Dock="Top"
                               Margin="9,7"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Select an element to edit its authored properties." />
                    <Expander x:Name="RawXmlExpander"
                              DockPanel.Dock="Bottom"
                              Header="Raw XML"
                              Visibility="Collapsed"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,1,0,0"
                              Padding="8,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="150" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox x:Name="RawXmlTextBox"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     SpellCheck.IsEnabled="False" />
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,5,0,0">
                                <Button Content="Reset"
                                        Click="ResetRawXml_Click" />
                                <Button Content="Apply XML"
                                        Click="ApplyRawXml_Click" />
                            </StackPanel>
                            <TextBlock x:Name="RawXmlErrorText"
                                       Grid.Row="2"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </Expander>
                    <ListBox ItemsSource="{Binding Source={StaticResource InspectorView}}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,1"
                                                Padding="8,5"
                                                Margin="0,5,0,2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:InspectorPropertyRow}">
                                <Grid Margin="8,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               ToolTip="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                             Tag="{Binding}"
                                             LostFocus="InspectorValue_LostFocus"
                                             KeyDown="InspectorValue_KeyDown"
                                             ToolTip="{Binding Error}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox"
                                                   BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChoices}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="BorderThickness"
                                                                Value="1.5" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMixed}"
                                                                 Value="True">
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource MutedTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Choices}"
                                              Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Tag="{Binding}"
                                              DropDownClosed="InspectorChoice_DropDownClosed"
                                              LostKeyboardFocus="InspectorChoice_LostKeyboardFocus"
                                              KeyDown="InspectorChoice_KeyDown"
                                              ToolTip="{Binding Error}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox"
                                                   BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChoices}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="BorderThickness"
                                                                Value="1.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <TabControl Grid.Row="4">
            <TabItem Header="Animation">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="5,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0">
                                <StackPanel Orientation="Horizontal"
                                            DockPanel.Dock="Left">
                                    <Button x:Name="PlayPauseButton"
                                            Content="Play"
                                            Click="PlayPause_Click" />
                                    <Button Content="Stop" Click="Stop_Click" />
                                    <Button Content="‹ Tick" Click="PreviousTick_Click" />
                                    <Button Content="Tick ›" Click="NextTick_Click" />
                                    <CheckBox x:Name="LoopCheckBox"
                                              Content="Loop"
                                              IsChecked="True"
                                              VerticalAlignment="Center"
                                              Margin="9,0" />
                                    <ToggleButton x:Name="AllTracksToggle"
                                                  Content="All tracks"
                                                  ToolTip="Show every timeline when no hierarchy node is selected"
                                                  Checked="AllTracksToggle_Changed"
                                                  Unchecked="AllTracksToggle_Changed" />
                                    <TextBlock Text="Speed"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,4,0" />
                                    <ComboBox x:Name="SpeedComboBox"
                                              Width="72"
                                              SelectedIndex="2">
                                        <ComboBoxItem Content="0.25×" Tag="0.25" />
                                        <ComboBoxItem Content="0.5×" Tag="0.5" />
                                        <ComboBoxItem Content="1×" Tag="1" />
                                        <ComboBoxItem Content="2×" Tag="2" />
                                        <ComboBoxItem Content="4×" Tag="4" />
                                    </ComboBox>
                                    <Separator Margin="5,3" />
                                    <Button Content="+ Key" Click="AddKeyFrame_Click" />
                                    <Button Content="Delete Key" Click="DeleteKeyFrame_Click" />
                                    <Button Content="Copy" Click="CopyKeyFrame_Click" />
                                    <Button Content="Paste" Click="PasteKeyFrame_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <TextBlock x:Name="TickText"
                                               VerticalAlignment="Center"
                                               Margin="8,0"
                                               FontFamily="Consolas" />
                                    <Slider x:Name="TickSlider"
                                            Width="300"
                                            Minimum="0"
                                            Maximum="1"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            ValueChanged="TickSlider_ValueChanged" />
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock Text="Selected key"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <TextBlock x:Name="KeyPropertyText"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <TextBox x:Name="KeyValueTextBox"
                                         Width="145"
                                         IsEnabled="False"
                                         ToolTip="Value for the selected property track"
                                         LostKeyboardFocus="KeyFrameValue_LostKeyboardFocus"
                                         KeyDown="KeyFrameValue_KeyDown" />
                                <ComboBox x:Name="KeyInterpolationComboBox"
                                          Width="88"
                                          Margin="5,0,0,0"
                                          IsEnabled="False"
                                          SelectionChanged="KeyInterpolation_SelectionChanged">
                                    <ComboBoxItem Content="Linear" Tag="0" />
                                    <ComboBoxItem Content="Eased" Tag="2" />
                                </ComboBox>
                                <TextBlock Text="In" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBox x:Name="EaseInTextBox"
                                         Width="48"
                                         IsEnabled="False"
                                         LostKeyboardFocus="KeyFrameEase_LostKeyboardFocus"
                                         KeyDown="KeyFrameEase_KeyDown" />
                                <TextBlock Text="Out" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBox x:Name="EaseOutTextBox"
                                         Width="48"
                                         IsEnabled="False"
                                         LostKeyboardFocus="KeyFrameEase_LostKeyboardFocus"
                                         KeyDown="KeyFrameEase_KeyDown" />
                                <TextBlock Text="Scale" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBox x:Name="EaseScaleTextBox"
                                         Width="48"
                                         IsEnabled="False"
                                         LostKeyboardFocus="KeyFrameEase_LostKeyboardFocus"
                                         KeyDown="KeyFrameEase_KeyDown" />
                                <TextBlock x:Name="KeyValueErrorText"
                                           Foreground="{StaticResource DangerBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                                <Separator Margin="8,3" />
                                <TextBlock Text="Named frame"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <ComboBox x:Name="NamedFrameComboBox"
                                          Width="132"
                                          SelectionChanged="NamedFrame_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox x:Name="NamedFrameNameTextBox"
                                         Width="110"
                                         Margin="4,0,0,0"
                                         ToolTip="Name" />
                                <TextBox x:Name="NamedFrameTickTextBox"
                                         Width="52"
                                         Margin="4,0,0,0"
                                         ToolTip="Tick" />
                                <ComboBox x:Name="NamedFrameCommandComboBox"
                                          Width="112"
                                          Margin="4,0,0,0"
                                          IsEditable="True"
                                          ToolTip="Command">
                                    <ComboBoxItem Content="" />
                                    <ComboBoxItem Content="stop" />
                                    <ComboBoxItem Content="goto" />
                                    <ComboBoxItem Content="gotoandstop" />
                                    <ComboBoxItem Content="gotoandplay" />
                                </ComboBox>
                                <TextBox x:Name="NamedFrameTargetTextBox"
                                         Width="105"
                                         Margin="4,0,0,0"
                                         ToolTip="Command target" />
                                <Button Content="+ Marker" Click="AddNamedFrame_Click" />
                                <Button Content="Apply" Click="ApplyNamedFrame_Click" />
                                <Button Content="Delete" Click="DeleteNamedFrame_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <controls:TimelineEditorControl x:Name="TimelineEditor"
                                                    Grid.Row="1"
                                                    TickChanged="TimelineEditor_TickChanged"
                                                    SelectedKeyFrameChanged="TimelineEditor_SelectedKeyFrameChanged"
                                                    KeyFrameMoveRequested="TimelineEditor_KeyFrameMoveRequested" />
                </Grid>
            </TabItem>
            <TabItem Header="Diagnostics">
                <DockPanel>
                    <TextBox x:Name="DiagnosticsSearch"
                             DockPanel.Dock="Top"
                             Margin="7"
                             ToolTip="Filter diagnostics"
                             TextChanged="DiagnosticsSearch_TextChanged" />
                    <DataGrid x:Name="DiagnosticsGrid"
                              ItemsSource="{Binding FilteredDiagnostics}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="{StaticResource PanelBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity"
                                                Binding="{Binding Severity}"
                                                Width="90" />
                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding Code}"
                                                Width="105" />
                            <DataGridTextColumn Header="Message"
                                                Binding="{Binding Message}"
                                                Width="*" />
                            <DataGridTextColumn Header="Node"
                                                Binding="{Binding NodeKey}"
                                                Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="DirtyText" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="DocumentStatsText" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="AssetStatusText" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
