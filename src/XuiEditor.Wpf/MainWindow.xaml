<Window x:Class="XuiEditor.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:XuiEditor.Wpf.Controls"
        xmlns:models="clr-namespace:XuiEditor.Wpf.Models"
        xmlns:services="clr-namespace:XuiEditor.Wpf.Services"
        Title="{DynamicResource Ui.Xaml.MainWindow.001}"
        Width="1500"
        Height="930"
        MinWidth="1050"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="Manual"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <services:LocalizedDiagnosticMessageConverter
            x:Key="LocalizedDiagnosticMessageConverter" />
        <services:LocalizedDiagnosticSeverityConverter
            x:Key="LocalizedDiagnosticSeverityConverter" />
        <CollectionViewSource x:Key="InspectorView"
                              Source="{Binding InspectorProperties}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style x:Key="CompactButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CompactBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CompactBorder"
                                        Property="Background"
                                        Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CompactBorder"
                                        Property="Background"
                                        Value="Transparent" />
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HierarchyToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="#8DC5E8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style x:Key="HierarchyVisibilityToggle"
               TargetType="CheckBox"
               BasedOn="{StaticResource HierarchyToggle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Viewbox Width="15"
                                     Height="15"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid Width="16" Height="16">
                                    <Path Data="M1,8 C3.4,4.2 6,3 8,3 C10,3 12.6,4.2 15,8 C12.6,11.8 10,13 8,13 C6,13 3.4,11.8 1,8 Z"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round" />
                                    <Ellipse Width="4.5"
                                             Height="4.5"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Fill="{TemplateBinding Foreground}" />
                                    <Path x:Name="VisibilitySlash"
                                          Visibility="Collapsed"
                                          Data="M2,2 L14,14"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="2.1"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path x:Name="VisibilityAncestorMarker"
                                          Visibility="Collapsed"
                                          Data="M11,1 L15,1 L15,5"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding VisibilityState}"
                                         Value="{x:Static models:HierarchyVisibilityState.Hidden}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="VisibilitySlash"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VisibilityState}"
                                         Value="{x:Static models:HierarchyVisibilityState.HiddenByAncestor}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource MutedTextBrush}" />
                                <Setter TargetName="VisibilitySlash"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter TargetName="VisibilityAncestorMarker"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="#42301F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="#8DC5E8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HierarchyLockToggle"
               TargetType="CheckBox"
               BasedOn="{StaticResource HierarchyToggle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="ToggleBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Viewbox Width="15"
                                     Height="15"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid Width="16" Height="16">
                                    <Path Data="M3,7 L13,7 L13,15 L3,15 Z"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round" />
                                    <Path x:Name="OpenShackle"
                                          Data="M5,7 L5,5 C5,2.5 7,1.5 9,1.5 C11,1.5 12.5,3 12.5,5"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path x:Name="ClosedShackle"
                                          Visibility="Collapsed"
                                          Data="M5,7 L5,5 C5,2.5 6.5,1.5 8,1.5 C9.5,1.5 11,2.5 11,5 L11,7"
                                          Fill="Transparent"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                    <Path x:Name="LockAncestorMarker"
                                          Visibility="Collapsed"
                                          Data="M11,1 L15,1 L15,5"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round" />
                                </Grid>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding LockState}"
                                         Value="{x:Static models:HierarchyLockState.Locked}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="OpenShackle"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                <Setter TargetName="ClosedShackle"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LockState}"
                                         Value="{x:Static models:HierarchyLockState.LockedByAncestor}">
                                <Setter Property="Foreground"
                                        Value="{StaticResource MutedTextBrush}" />
                                <Setter TargetName="OpenShackle"
                                        Property="Visibility"
                                        Value="Collapsed" />
                                <Setter TargetName="ClosedShackle"
                                        Property="Visibility"
                                        Value="Visible" />
                                <Setter TargetName="LockAncestorMarker"
                                        Property="Visibility"
                                        Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="#30353B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="#42301F" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="#8DC5E8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PaneHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="9,7" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition x:Name="TimelineRow" Height="250" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.002}">
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.003}" InputGestureText="Ctrl+O"
                          Click="Open_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.004}"
                          Click="OpenStock_Click" />
                <MenuItem x:Name="RecentFilesMenu" Header="{DynamicResource Ui.Xaml.MainWindow.005}" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.006}" InputGestureText="Ctrl+S"
                          Click="Save_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.007}" InputGestureText="Ctrl+Shift+S"
                          Click="SaveAs_Click" />
                <MenuItem x:Name="ExportPngMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.008}"
                          ToolTip="{DynamicResource Ui.Xaml.MainWindow.009}"
                          Click="ExportPng_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.010}" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.011}">
                <MenuItem x:Name="UndoMenuItem" Header="{DynamicResource Ui.Xaml.MainWindow.012}"
                          InputGestureText="Ctrl+Z" Click="Undo_Click" />
                <MenuItem x:Name="RedoMenuItem" Header="{DynamicResource Ui.Xaml.MainWindow.013}"
                          InputGestureText="Ctrl+Y" Click="Redo_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.014}" InputGestureText="Ctrl+D"
                          Click="Duplicate_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.015}" InputGestureText="Delete"
                          Click="Delete_Click" />
                <Separator />
                <MenuItem x:Name="CopyInspectorPropertiesMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.016}"
                          InputGestureText="Ctrl+C"
                          Click="CopyInspectorProperties_Click" />
                <MenuItem x:Name="AdvancedCopyInspectorPropertiesMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.017}"
                          InputGestureText="Ctrl+Shift+C"
                          Click="AdvancedCopyInspectorProperties_Click" />
                <MenuItem x:Name="PasteInspectorPropertiesMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.018}"
                          InputGestureText="Ctrl+V"
                          Click="PasteInspectorProperties_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.019}" InputGestureText="Alt+Up"
                          Click="MoveUp_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.020}" InputGestureText="Alt+Down"
                          Click="MoveDown_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.021}" InputGestureText="Alt+Right"
                          Click="Indent_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.022}" InputGestureText="Alt+Left"
                          Click="Outdent_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.023}">
                <MenuItem x:Name="GridMenuItem" Header="{DynamicResource Ui.Xaml.MainWindow.024}"
                          IsCheckable="True" Click="Grid_Click" />
                <MenuItem x:Name="SafeAreaMenuItem" Header="{DynamicResource Ui.Xaml.MainWindow.025}"
                          IsCheckable="True" Click="SafeArea_Click" />
                <MenuItem x:Name="BoundsMenuItem" Header="{DynamicResource Ui.Xaml.MainWindow.026}"
                          IsCheckable="True" Click="Bounds_Click" />
                <MenuItem x:Name="SnapMenuItem" Header="{DynamicResource Ui.Xaml.MainWindow.027}"
                          IsCheckable="True" Click="Snap_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.028}"
                          Click="GridSettings_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.029}"
                          Click="SelectParentGroup_Click" />
                <MenuItem x:Name="ParentMaskMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.030}"
                          IsCheckable="True"
                          Click="ParentMask_Click" />
                <MenuItem x:Name="GrayOutsideGroupMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.031}"
                          IsCheckable="True"
                          Click="GrayOutsideGroup_Click" />
                <MenuItem x:Name="DesignTimeMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.032}"
                          IsCheckable="True"
                          Click="DesignTime_Click" />
                <MenuItem x:Name="NavigationMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.033}"
                          IsCheckable="True"
                          Click="Navigation_Click" />
                <MenuItem x:Name="NavigationAllMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.034}"
                          IsCheckable="True"
                          Click="NavigationAll_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.035}" InputGestureText="F"
                          Click="Fit_Click" />
                <MenuItem Header="_100%" InputGestureText="0"
                          Click="ActualPixels_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.036}" InputGestureText="+"
                          Click="ZoomIn_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.037}" InputGestureText="-"
                          Click="ZoomOut_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.038}"
                          Click="LoadReferenceImage_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.039}"
                          Click="ClearReferenceImage_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.040}"
                          Click="ForceShowSelected_Click" />
                <MenuItem x:Name="ForceShowGroupMenuItem"
                          Header="{DynamicResource Ui.Xaml.MainWindow.041}"
                          IsCheckable="True"
                          Click="ForceShowCurrentGroup_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.042}"
                          Click="ForceShowAll_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.043}"
                          Click="ClearForceShown_Click" />
            </MenuItem>
            <MenuItem x:Name="AnimationMenuItem"
                      Header="{DynamicResource Ui.Xaml.MainWindow.044}">
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.045}" InputGestureText="Space"
                          Click="PlayPause_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.046}" Click="Stop_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.047}" InputGestureText=","
                          Click="PreviousTick_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.048}" InputGestureText="."
                          Click="NextTick_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.049}" Click="AddKeyFrame_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.050}" Click="DeleteKeyFrame_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.051}" InputGestureText="Ctrl+Alt+C"
                          Click="CopyKeyFrame_Click" />
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.052}" InputGestureText="Ctrl+Alt+V"
                          Click="PasteKeyFrame_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.053}">
                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.054}"
                          ToolTip="{DynamicResource Ui.Xaml.MainWindow.055}"
                          Click="AssetRoots_Click" />
                <Separator />
                <MenuItem x:Name="InterfaceLanguageMenuItem"
                          Header="{DynamicResource Ui.Settings.InterfaceLanguage}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Background="{StaticResource PanelRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="5,3">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="{DynamicResource Ui.Xaml.MainWindow.056}" ToolTip="{DynamicResource Ui.Xaml.MainWindow.057}"
                            Click="Open_Click" />
                    <Button Content="{DynamicResource Ui.Xaml.MainWindow.058}"
                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.059}"
                            Click="OpenStock_Click" />
                    <Button Content="{DynamicResource Ui.Xaml.MainWindow.060}" ToolTip="{DynamicResource Ui.Xaml.MainWindow.061}"
                            Click="Save_Click" />
                    <Separator Margin="5,3" />
                    <Button Content="{DynamicResource Ui.Xaml.MainWindow.062}" ToolTip="{DynamicResource Ui.Xaml.MainWindow.063}"
                            Click="Undo_Click" />
                    <Button Content="{DynamicResource Ui.Xaml.MainWindow.064}" ToolTip="{DynamicResource Ui.Xaml.MainWindow.065}"
                            Click="Redo_Click" />
                    <Separator Margin="5,3" />
                    <TextBlock Text="{DynamicResource Ui.Command.AlignSelection}"
                               Margin="4,0,3,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="AlignLeftButton"
                            Style="{StaticResource CompactButton}"
                            Content="←"
                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.206}"
                            AutomationProperties.Name="{DynamicResource Ui.Xaml.MainWindow.206}"
                            Tag="Left"
                            IsEnabled="False"
                            Click="AlignSelection_Click" />
                    <Button x:Name="AlignCenterButton"
                            Style="{StaticResource CompactButton}"
                            Content="•"
                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.207}"
                            AutomationProperties.Name="{DynamicResource Ui.Xaml.MainWindow.207}"
                            Tag="Center"
                            IsEnabled="False"
                            Click="AlignSelection_Click" />
                    <Button x:Name="AlignRightButton"
                            Style="{StaticResource CompactButton}"
                            Content="→"
                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.208}"
                            AutomationProperties.Name="{DynamicResource Ui.Xaml.MainWindow.208}"
                            Tag="Right"
                            IsEnabled="False"
                            Click="AlignSelection_Click" />
                    <Button x:Name="AlignTopButton"
                            Style="{StaticResource CompactButton}"
                            Content="↑"
                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.209}"
                            AutomationProperties.Name="{DynamicResource Ui.Xaml.MainWindow.209}"
                            Tag="Top"
                            IsEnabled="False"
                            Click="AlignSelection_Click" />
                    <Button x:Name="AlignBottomButton"
                            Style="{StaticResource CompactButton}"
                            Content="↓"
                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.210}"
                            AutomationProperties.Name="{DynamicResource Ui.Xaml.MainWindow.210}"
                            Tag="Bottom"
                            IsEnabled="False"
                            Click="AlignSelection_Click" />
                    <Separator Margin="5,3" />
                    <Button Content="{DynamicResource Ui.Xaml.MainWindow.066}" ToolTip="{DynamicResource Ui.Xaml.MainWindow.067}"
                            Click="Fit_Click" />
                    <Button Content="100%" ToolTip="{DynamicResource Ui.Xaml.MainWindow.068}"
                            Click="ActualPixels_Click" />
                    <Button Content="−" ToolTip="{DynamicResource Ui.Xaml.MainWindow.069}"
                            Click="ZoomOut_Click" />
                    <Button Content="+" ToolTip="{DynamicResource Ui.Xaml.MainWindow.070}"
                            Click="ZoomIn_Click" />
                    <Separator Margin="5,3" />
                    <Button x:Name="ExportPngButton"
                            Content="{DynamicResource Ui.Xaml.MainWindow.071}"
                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.072}"
                            Click="ExportPng_Click" />
                    <Separator Margin="5,3" />
                    <ToggleButton x:Name="ToolbarSnap"
                                  Content="{DynamicResource Ui.Xaml.MainWindow.073}"
                                  Padding="10,5"
                                  Margin="2"
                                  Checked="ToolbarSnap_Changed"
                                  Unchecked="ToolbarSnap_Changed" />
                    <Separator Margin="5,3" />
                    <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.074}"
                               Margin="4,0,3,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               VerticalAlignment="Center" />
                    <Slider x:Name="ReferenceOpacitySlider"
                            Width="72"
                            Minimum="0"
                            Maximum="1"
                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.075}"
                            ValueChanged="ReferenceOpacitySlider_ValueChanged" />
                </StackPanel>
                <TextBlock x:Name="DocumentPathText"
                           DockPanel.Dock="Right"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           TextAlignment="Right"
                           Margin="12,0,5,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HierarchyColumn" Width="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="InspectorColumn" Width="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button x:Name="CollapseHierarchyButton"
                                        Style="{StaticResource CompactButton}"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.076}"
                                        Margin="0,0,5,0"
                                        ToolTip="{DynamicResource Ui.Xaml.MainWindow.077}"
                                        Click="CollapseHierarchy_Click" />
                                <Button x:Name="RevealHierarchyButton"
                                        Style="{StaticResource CompactButton}"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.078}"
                                        ToolTip="{DynamicResource Ui.Xaml.MainWindow.079}"
                                        Click="RevealHierarchySelection_Click" />
                                <TextBlock x:Name="HierarchyCountText"
                                           Margin="7,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.080}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="BreadcrumbText"
                               DockPanel.Dock="Top"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,6,8,2" />
                    <TextBox x:Name="HierarchySearch"
                             DockPanel.Dock="Top"
                             Margin="7,5,7,7"
                             ToolTip="{DynamicResource Ui.Xaml.MainWindow.081}"
                             TextChanged="HierarchySearch_TextChanged" />
                    <ListBox x:Name="HierarchyList"
                             ItemsSource="{Binding HierarchyRows}"
                             SelectionMode="Extended"
                             SelectionChanged="HierarchyList_SelectionChanged"
                             KeyDown="HierarchyList_KeyDown"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Height" Value="24" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:HierarchyRow}">
                                <Grid Height="24">
                                    <Grid.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Opened="HierarchyContextMenu_Opened">
                                            <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.082}"
                                                      InputGestureText="Ctrl+Insert"
                                                      Click="HierarchyAddChild_Click" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.083}"
                                                      ToolTip="{DynamicResource Ui.Xaml.MainWindow.084}"
                                                      Click="HierarchyIsolate_Click" />
                                            <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.085}"
                                                      Tag="RestoreIsolation"
                                                      Click="HierarchyRestoreIsolation_Click" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.086}"
                                                      Click="HierarchyShowAll_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="23" />
                                        <ColumnDefinition Width="23" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="{Binding Indent}" />
                                    <Button Grid.Column="1"
                                            Tag="{Binding}"
                                            Click="HierarchyExpand_Click"
                                            IsEnabled="{Binding HasChildren}">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource CompactButton}">
                                                <Setter Property="Content" Value="›" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExpanded}"
                                                                 Value="True">
                                                        <Setter Property="Content" Value="⌄" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasChildren}"
                                                                 Value="False">
                                                        <Setter Property="Content" Value="" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Opacity="{Binding RowTextOpacity}">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ElementName, StringFormat=  · {0}}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="3"
                                              Style="{StaticResource HierarchyVisibilityToggle}"
                                              Tag="{Binding}"
                                              IsChecked="{Binding IsEditorVisible}"
                                              IsEnabled="{Binding CanToggleVisibility}"
                                              Click="HierarchyVisibility_Click"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding VisibilityToolTip}"
                                              ToolTipService.ShowOnDisabled="True"
                                              AutomationProperties.Name="{Binding VisibilityAutomationName}" />
                                    <CheckBox Grid.Column="4"
                                              Style="{StaticResource HierarchyLockToggle}"
                                              Tag="{Binding}"
                                              IsChecked="{Binding IsLocked}"
                                              IsEnabled="{Binding CanToggleLock}"
                                              Click="HierarchyLock_Click"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding LockToolTip}"
                                              ToolTipService.ShowOnDisabled="True"
                                              AutomationProperties.Name="{Binding LockAutomationName}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <controls:XuiViewportControl x:Name="Viewport"
                                             AllowDrop="True"
                                             SelectionRequested="Viewport_SelectionRequested"
                                             TransformCommitted="Viewport_TransformCommitted"
                                             NavigationEditRequested="Viewport_NavigationEditRequested"
                                             DragOver="Viewport_AssetDragOver"
                                             DragLeave="Viewport_AssetDragLeave"
                                             Drop="Viewport_AssetDrop">
                    <controls:XuiViewportControl.ContextMenu>
                        <ContextMenu Opened="ViewportContextMenu_Opened">
                            <MenuItem Header="{DynamicResource Ui.Command.AlignSelection}">
                                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.206}"
                                          Tag="Left"
                                          Click="AlignSelection_Click" />
                                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.207}"
                                          Tag="Center"
                                          Click="AlignSelection_Click" />
                                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.208}"
                                          Tag="Right"
                                          Click="AlignSelection_Click" />
                                <Separator />
                                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.209}"
                                          Tag="Top"
                                          Click="AlignSelection_Click" />
                                <MenuItem Header="{DynamicResource Ui.Xaml.MainWindow.210}"
                                          Tag="Bottom"
                                          Click="AlignSelection_Click" />
                            </MenuItem>
                        </ContextMenu>
                    </controls:XuiViewportControl.ContextMenu>
                </controls:XuiViewportControl>
                <Grid x:Name="ViewportLoadingOverlay"
                      Panel.ZIndex="100"
                      Background="#F0000000"
                      Visibility="Collapsed"
                      IsHitTestVisible="True">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <controls:AnimatedGifImage x:Name="LoadingGears"
                                                   Width="176"
                                                   Height="176"
                                                   Stretch="Uniform"
                                                   SourceUri="/DyingLightXuiEditor;component/Assets/MovingGears.gif"
                                                   AutomationProperties.Name="{DynamicResource Ui.Xaml.MainWindow.087}" />
                        <TextBlock Margin="0,16,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Text="{DynamicResource Ui.Xaml.MainWindow.088}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <Border Grid.Column="4"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.097}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectionCountText"
                                       Grid.Row="0"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" />
                            <UniformGrid Grid.Row="1"
                                         Columns="2"
                                         Margin="0,5,0,-3">
                                <ToggleButton x:Name="AdvancedInspectorToggle"
                                              Content="{DynamicResource Ui.Xaml.MainWindow.089}"
                                              Margin="0,0,4,0"
                                              Padding="8,2"
                                              ToolTip="{DynamicResource Ui.Xaml.MainWindow.090}"
                                              Click="AdvancedInspector_Click" />
                                <Button x:Name="AddPropertyButton"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.091}"
                                        Margin="0,0,4,0"
                                        Padding="8,2"
                                        ToolTip="{DynamicResource Ui.Xaml.MainWindow.092}"
                                        Click="AddProperty_Click" />
                                <Button x:Name="AddParentButton"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.093}"
                                        Margin="0,0,4,0"
                                        Padding="8,2"
                                        ToolTip="{DynamicResource Ui.Xaml.MainWindow.094}"
                                        Click="AddParent_Click" />
                                <Button x:Name="AddChildButton"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.095}"
                                        Padding="8,2"
                                        ToolTip="{DynamicResource Ui.Xaml.MainWindow.096}"
                                        Click="AddChild_Click" />
                            </UniformGrid>
                        </Grid>
                    </Border>
                    <Border DockPanel.Dock="Top"
                            Padding="8,5"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal">
                                <Button x:Name="CopyInspectorPropertiesButton"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.098}"
                                        Padding="8,2"
                                        ToolTip="{DynamicResource Ui.Xaml.MainWindow.099}"
                                        Click="CopyInspectorProperties_Click" />
                                <Button x:Name="AdvancedCopyInspectorPropertiesButton"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.100}"
                                        Padding="8,2"
                                        ToolTip="{DynamicResource Ui.Xaml.MainWindow.101}"
                                        Click="AdvancedCopyInspectorProperties_Click" />
                                <Button x:Name="PasteInspectorPropertiesButton"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.102}"
                                        Padding="8,2"
                                        ToolTip="{DynamicResource Ui.Xaml.MainWindow.103}"
                                        Click="PasteInspectorProperties_Click" />
                            </StackPanel>
                            <TextBlock x:Name="PropertyClipboardText"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{DynamicResource Ui.Xaml.MainWindow.104}"
                                       TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="InspectorHint"
                                   Margin="9,7"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{DynamicResource Ui.Xaml.MainWindow.105}" />
                        <Expander x:Name="TextStyleExpander"
                                  Header="{DynamicResource Ui.Xaml.MainWindow.106}"
                                  Margin="8,0,8,4"
                                  Visibility="Collapsed"
                                  IsExpanded="True">
                            <StackPanel Margin="5,4,0,5">
                                <WrapPanel>
                                    <CheckBox x:Name="TextBoldCheckBox"
                                              Content="{DynamicResource Ui.Xaml.MainWindow.107}"
                                              Margin="0,0,10,3"
                                              Click="TextStyleFlag_Click" />
                                    <CheckBox x:Name="TextItalicCheckBox"
                                              Content="{DynamicResource Ui.Xaml.MainWindow.108}"
                                              Margin="0,0,10,3"
                                              Click="TextStyleFlag_Click" />
                                    <CheckBox x:Name="TextUnderlineCheckBox"
                                              Content="{DynamicResource Ui.Xaml.MainWindow.109}"
                                              Margin="0,0,10,3"
                                              Click="TextStyleFlag_Click" />
                                </WrapPanel>
                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.110}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox x:Name="TextHorizontalComboBox"
                                              Grid.Column="1"
                                              SelectionChanged="TextHorizontal_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.111}" Tag="Unspecified" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.112}" Tag="Left" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.113}" Tag="Center" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.114}" Tag="Right" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource Ui.Xaml.MainWindow.115}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ComboBox x:Name="TextVerticalComboBox"
                                              Grid.Column="3"
                                              SelectionChanged="TextVertical_SelectionChanged">
                                        <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.116}" Tag="Top" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.117}" Tag="Middle" />
                                        <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.118}" Tag="Bottom" />
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="TextStyleRawText"
                                           Margin="0,5,0,0"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <Expander x:Name="PivotExpander"
                                  Header="{DynamicResource Ui.Xaml.MainWindow.119}"
                                  Margin="8,0,8,5"
                                  Visibility="Collapsed"
                                  IsExpanded="True">
                            <StackPanel Margin="5,4,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.120}" VerticalAlignment="Center" />
                                    <TextBox x:Name="PivotXTextBox"
                                             Grid.Column="1"
                                             LostKeyboardFocus="PivotValue_LostKeyboardFocus"
                                             KeyDown="PivotValue_KeyDown" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource Ui.Xaml.MainWindow.121}"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="PivotYTextBox"
                                             Grid.Column="3"
                                             LostKeyboardFocus="PivotValue_LostKeyboardFocus"
                                             KeyDown="PivotValue_KeyDown" />
                                    <TextBlock Grid.Column="4" Text="{DynamicResource Ui.Xaml.MainWindow.122}"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="PivotZTextBox"
                                             Grid.Column="5"
                                             LostKeyboardFocus="PivotValue_LostKeyboardFocus"
                                             KeyDown="PivotValue_KeyDown" />
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,5,0,0">
                                    <Button Content="↖" Tag="TopLeft"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.123}"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↑" Tag="TopCenter"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.124}"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↗" Tag="TopRight"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.125}"
                                            Click="PivotPreset_Click" />
                                    <Button Content="←" Tag="MiddleLeft"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.126}"
                                            Click="PivotPreset_Click" />
                                    <Button Content="•" Tag="Center"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.127}"
                                            Click="PivotPreset_Click" />
                                    <Button Content="→" Tag="MiddleRight"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.128}"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↙" Tag="BottomLeft"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.129}"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↓" Tag="BottomCenter"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.130}"
                                            Click="PivotPreset_Click" />
                                    <Button Content="↘" Tag="BottomRight"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.131}"
                                            Click="PivotPreset_Click" />
                                </UniformGrid>
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.132}"
                                        Tag="Origin"
                                        Margin="0,4,0,0"
                                        ToolTip="{DynamicResource Ui.Xaml.MainWindow.133}"
                                        Click="PivotPreset_Click" />
                                <CheckBox x:Name="PreservePivotPositionCheckBox"
                                          Margin="0,5,0,0"
                                          Content="{DynamicResource Ui.Xaml.MainWindow.134}"
                                          ToolTip="{DynamicResource Ui.Xaml.MainWindow.135}"
                                          Click="PreservePivotPosition_Click" />
                                <TextBlock x:Name="PivotStatusText"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <Expander x:Name="RawXmlExpander"
                              DockPanel.Dock="Bottom"
                              Header="{DynamicResource Ui.Xaml.MainWindow.136}"
                              Visibility="Collapsed"
                              Expanded="RawXmlExpander_Expanded"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="0,1,0,0"
                              Padding="8,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="150" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0"
                                       Margin="0,0,0,5">
                                <Button x:Name="LoadLargeRawXmlButton"
                                        DockPanel.Dock="Right"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.137}"
                                        Visibility="Collapsed"
                                        Click="LoadLargeRawXml_Click" />
                                <TextBlock x:Name="RawXmlStatusText"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBox x:Name="RawXmlTextBox"
                                     Grid.Row="1"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="NoWrap"
                                     SpellCheck.IsEnabled="False" />
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,5,0,0">
                                <Button x:Name="ResetRawXmlButton"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.138}"
                                        Click="ResetRawXml_Click" />
                                <Button x:Name="ApplyRawXmlButton"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.139}"
                                        Click="ApplyRawXml_Click" />
                            </StackPanel>
                            <TextBlock x:Name="RawXmlErrorText"
                                       Grid.Row="3"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                        </Grid>
                    </Expander>
                    <ListBox x:Name="InspectorList"
                             ItemsSource="{Binding Source={StaticResource InspectorView}}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             SelectionChanged="InspectorList_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelRaisedBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,1,0,1"
                                                Padding="8,5"
                                                Margin="0,5,0,2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:InspectorPropertyRow}">
                                <Grid Margin="8,3"
                                      ToolTip="{Binding EditorToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="176" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="25" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               ToolTip="{Binding EditorToolTip}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                             Tag="{Binding}"
                                             LostFocus="InspectorValue_LostFocus"
                                             KeyDown="InspectorValue_KeyDown"
                                             ToolTip="{Binding EditorToolTip}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox"
                                                   BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGhostDefault}"
                                                                 Value="True">
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                        <Setter Property="Opacity" Value="0.68" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasChoices}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsBooleanToggle}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="BorderThickness"
                                                                Value="1.5" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMixed}"
                                                                 Value="True">
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                        <Setter Property="Foreground"
                                                                Value="{StaticResource MutedTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding Choices}"
                                              Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              Tag="{Binding}"
                                              DropDownClosed="InspectorChoice_DropDownClosed"
                                              LostKeyboardFocus="InspectorChoice_LostKeyboardFocus"
                                              KeyDown="InspectorChoice_KeyDown"
                                              ToolTip="{Binding EditorToolTip}">
                                        <ComboBox.Style>
                                            <Style TargetType="ComboBox"
                                                   BasedOn="{StaticResource {x:Type ComboBox}}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasChoices}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasError}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource DangerBrush}" />
                                                        <Setter Property="BorderThickness"
                                                                Value="1.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ComboBox.Style>
                                    </ComboBox>
                                    <CheckBox Grid.Column="1"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsThreeState="{Binding IsMixed}"
                                              IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Tag="{Binding}"
                                              ToolTip="{Binding EditorToolTip}"
                                              AutomationProperties.Name="{Binding Name}"
                                              Click="InspectorBoolean_Click">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox"
                                                   BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBooleanToggle}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <Button Grid.Column="2"
                                            Content="⧉"
                                            FontFamily="Segoe UI Symbol"
                                            Padding="2,0"
                                            Margin="3,0,0,0"
                                            Tag="{Binding}"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.140}"
                                            AutomationProperties.Name="{DynamicResource Ui.Xaml.MainWindow.141}"
                                            Click="InspectorCopySingleProperty_Click" />
                                    <Button Grid.Column="3"
                                            Content="×"
                                            Padding="2,0"
                                            Margin="3,0,0,0"
                                            Tag="{Binding}"
                                            ToolTip="{DynamicResource Ui.Xaml.MainWindow.142}"
                                            Click="InspectorReset_Click">
                                        <Button.Style>
                                            <Style TargetType="Button"
                                                   BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanReset}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="3"
                      Height="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" />

        <TabControl Grid.Row="4">
            <TabItem x:Name="AnimationTab" Header="{DynamicResource Ui.Xaml.MainWindow.143}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="5,3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="TimelineTransportPanel"
                                            Orientation="Horizontal"
                                            Grid.Column="0"
                                            VerticalAlignment="Top">
                                    <TextBlock x:Name="TimelineScopeText"
                                               MinWidth="150"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="2,0,8,0"
                                               Text="{DynamicResource Ui.Xaml.MainWindow.144}" />
                                    <ToggleButton x:Name="IncludeDescendantsToggle"
                                                  Content="{DynamicResource Ui.Xaml.MainWindow.145}"
                                                  Margin="0,0,5,0"
                                                  ToolTip="{DynamicResource Ui.Xaml.MainWindow.146}"
                                                  Checked="IncludeDescendantsToggle_Changed"
                                                  Unchecked="IncludeDescendantsToggle_Changed" />
                                    <StackPanel x:Name="TimelineActionsPanel"
                                                Orientation="Horizontal">
                                        <Button x:Name="PlayPauseButton"
                                                Content="{DynamicResource Ui.Xaml.MainWindow.147}"
                                                Click="PlayPause_Click" />
                                        <Button Content="{DynamicResource Ui.Xaml.MainWindow.148}" Click="Stop_Click" />
                                        <Button Content="{DynamicResource Ui.Xaml.MainWindow.149}" Click="PreviousTick_Click" />
                                        <Button Content="{DynamicResource Ui.Xaml.MainWindow.150}" Click="NextTick_Click" />
                                        <CheckBox x:Name="LoopCheckBox"
                                                  Content="{DynamicResource Ui.Xaml.MainWindow.151}"
                                                  IsChecked="True"
                                                  VerticalAlignment="Center"
                                                  Margin="9,0" />
                                        <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.152}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,4,0" />
                                        <ComboBox x:Name="SpeedComboBox"
                                                  Width="72"
                                                  SelectedIndex="2">
                                            <ComboBoxItem Content="0.25×" Tag="0.25" />
                                            <ComboBoxItem Content="0.5×" Tag="0.5" />
                                            <ComboBoxItem Content="1×" Tag="1" />
                                            <ComboBoxItem Content="2×" Tag="2" />
                                            <ComboBoxItem Content="4×" Tag="4" />
                                        </ComboBox>
                                        <Separator Margin="5,3" />
                                        <Button Content="{DynamicResource Ui.Xaml.MainWindow.153}" Click="AddKeyFrame_Click" />
                                        <Button Content="{DynamicResource Ui.Xaml.MainWindow.154}" Click="DeleteKeyFrame_Click" />
                                        <Button Content="{DynamicResource Ui.Xaml.MainWindow.155}" Click="CopyKeyFrame_Click" />
                                        <Button Content="{DynamicResource Ui.Xaml.MainWindow.156}" Click="PasteKeyFrame_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                    <TextBlock x:Name="TickText"
                                               VerticalAlignment="Center"
                                               Margin="8,0"
                                               FontFamily="Consolas" />
                                    <Slider x:Name="TickSlider"
                                            Width="300"
                                            Minimum="0"
                                            Maximum="1"
                                            IsSnapToTickEnabled="True"
                                            TickFrequency="1"
                                            ValueChanged="TickSlider_ValueChanged" />
                                </StackPanel>
                            </Grid>
                            <Border x:Name="PreviewStatePanel"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    MaxWidth="440"
                                    HorizontalAlignment="Right"
                                    Margin="8,4,0,0"
                                    Padding="6,4"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0">
                                        <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.160}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="PreviewStateText"
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,5,0,0">
                                        <Button x:Name="ForceShowInspectorButton"
                                                Content="{DynamicResource Ui.Xaml.MainWindow.157}"
                                                Padding="7,2"
                                                Margin="0,0,4,0"
                                                Click="ForceShowSelected_Click" />
                                        <Button x:Name="RestoreComposedPoseButton"
                                                Content="{DynamicResource Ui.Xaml.MainWindow.158}"
                                                Padding="7,2"
                                                ToolTip="{DynamicResource Ui.Xaml.MainWindow.159}"
                                                Click="RestoreComposedPose_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <WrapPanel x:Name="TimelineEditPanel"
                                       Grid.Row="2"
                                       Margin="0,4,0,0">
                                <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.161}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <TextBlock x:Name="KeyPropertyText"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <TextBox x:Name="KeyValueTextBox"
                                         Width="145"
                                         IsEnabled="False"
                                         ToolTip="{DynamicResource Ui.Xaml.MainWindow.162}"
                                         LostKeyboardFocus="KeyFrameValue_LostKeyboardFocus"
                                         KeyDown="KeyFrameValue_KeyDown" />
                                <ComboBox x:Name="KeyInterpolationComboBox"
                                          Width="88"
                                          Margin="5,0,0,0"
                                          IsEnabled="False"
                                          SelectionChanged="KeyInterpolation_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.163}" Tag="0" />
                                    <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.164}" Tag="2" />
                                </ComboBox>
                                <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.165}" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBox x:Name="EaseInTextBox"
                                         Width="48"
                                         IsEnabled="False"
                                         LostKeyboardFocus="KeyFrameEase_LostKeyboardFocus"
                                         KeyDown="KeyFrameEase_KeyDown" />
                                <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.166}" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBox x:Name="EaseOutTextBox"
                                         Width="48"
                                         IsEnabled="False"
                                         LostKeyboardFocus="KeyFrameEase_LostKeyboardFocus"
                                         KeyDown="KeyFrameEase_KeyDown" />
                                <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.167}" VerticalAlignment="Center" Margin="6,0,3,0" />
                                <TextBox x:Name="EaseScaleTextBox"
                                         Width="48"
                                         IsEnabled="False"
                                         LostKeyboardFocus="KeyFrameEase_LostKeyboardFocus"
                                         KeyDown="KeyFrameEase_KeyDown" />
                                <TextBlock x:Name="KeyValueErrorText"
                                           Foreground="{StaticResource DangerBrush}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                                <Separator Margin="8,3" />
                                <TextBlock Text="{DynamicResource Ui.Xaml.MainWindow.168}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />
                                <ComboBox x:Name="NamedFrameComboBox"
                                          Width="132"
                                          SelectionChanged="NamedFrame_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox x:Name="NamedFrameNameTextBox"
                                         Width="110"
                                         Margin="4,0,0,0"
                                         ToolTip="{DynamicResource Ui.Xaml.MainWindow.169}" />
                                <TextBox x:Name="NamedFrameTickTextBox"
                                         Width="52"
                                         Margin="4,0,0,0"
                                         ToolTip="{DynamicResource Ui.Xaml.MainWindow.170}" />
                                <ComboBox x:Name="NamedFrameCommandComboBox"
                                          Width="112"
                                          Margin="4,0,0,0"
                                          IsEditable="True"
                                          ToolTip="{DynamicResource Ui.Xaml.MainWindow.171}">
                                    <ComboBoxItem Content="" />
                                    <ComboBoxItem Content="stop" />
                                    <ComboBoxItem Content="goto" />
                                    <ComboBoxItem Content="gotoandstop" />
                                    <ComboBoxItem Content="gotoandplay" />
                                </ComboBox>
                                <TextBox x:Name="NamedFrameTargetTextBox"
                                         Width="105"
                                         Margin="4,0,0,0"
                                         ToolTip="{DynamicResource Ui.Xaml.MainWindow.172}" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.173}" Click="AddNamedFrame_Click" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.174}" Click="GoToNamedFrame_Click" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.175}" Click="ApplyNamedFrame_Click" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.176}" Click="DeleteNamedFrame_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <controls:TimelineEditorControl x:Name="TimelineEditor"
                                                    Grid.Row="1"
                                                    TickChanged="TimelineEditor_TickChanged"
                                                    SelectedKeyFrameChanged="TimelineEditor_SelectedKeyFrameChanged"
                                                    KeyFrameMoveRequested="TimelineEditor_KeyFrameMoveRequested" />
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource Ui.Xaml.MainWindow.177}">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource PanelRaisedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="6,4">
                        <StackPanel>
                            <WrapPanel>
                                <TextBox x:Name="AssetSearchTextBox"
                                         Width="260"
                                         ToolTip="{DynamicResource Ui.Xaml.MainWindow.178}"
                                         TextChanged="AssetSearch_TextChanged" />
                                <ComboBox x:Name="AssetKindComboBox"
                                          Width="115"
                                          Margin="6,0,0,0"
                                          SelectedIndex="0"
                                          SelectionChanged="AssetKind_SelectionChanged">
                                    <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.179}" Tag="All" />
                                    <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.180}" Tag="Screen" />
                                    <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.181}" Tag="Visual" />
                                    <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.182}" Tag="Texture" />
                                    <ComboBoxItem Content="{DynamicResource Ui.Xaml.MainWindow.183}" Tag="Font" />
                                </ComboBox>
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox x:Name="AutoSizeAssetDropCheckBox"
                                          Content="{DynamicResource Ui.Xaml.MainWindow.184}"
                                          VerticalAlignment="Center"
                                          Margin="4,0,8,0"
                                          ToolTip="{DynamicResource Ui.Xaml.MainWindow.185}" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.186}" Click="AssetOpen_Click" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.187}"
                                        Click="AssetCopy_Click" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.188}"
                                        Click="AssetNewScreen_Click" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.189}"
                                        Click="AssetNewVisual_Click" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.190}"
                                        Click="AssetRename_Click" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.191}"
                                        Click="AssetDelete_Click" />
                                <Button Content="{DynamicResource Ui.Xaml.MainWindow.192}"
                                        Click="AssetReferences_Click" />
                                <Button x:Name="UndoReferenceTransactionButton"
                                        Content="{DynamicResource Ui.Xaml.MainWindow.193}"
                                        IsEnabled="False"
                                        Click="AssetUndoReferenceTransaction_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="AssetList"
                              ItemsSource="{Binding AssetRows}"
                              PreviewMouseLeftButtonDown="AssetList_MouseLeftButtonDown"
                              PreviewMouseMove="AssetList_MouseMove"
                              MouseDoubleClick="AssetList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{DynamicResource Ui.Xaml.MainWindow.194}"
                                                DisplayMemberBinding="{Binding KindLabel}"
                                                Width="85" />
                                <GridViewColumn Header="{DynamicResource Ui.Xaml.MainWindow.195}"
                                                DisplayMemberBinding="{Binding Name}"
                                                Width="240" />
                                <GridViewColumn Header="{DynamicResource Ui.Xaml.MainWindow.196}"
                                                DisplayMemberBinding="{Binding SizeLabel}"
                                                Width="100" />
                                <GridViewColumn Header="{DynamicResource Ui.Xaml.MainWindow.197}"
                                                DisplayMemberBinding="{Binding AccessLabel}"
                                                Width="95" />
                                <GridViewColumn Header="{DynamicResource Ui.Xaml.MainWindow.198}"
                                                DisplayMemberBinding="{Binding SourceDisplayPath}"
                                                Width="520" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>
            <TabItem Header="{DynamicResource Ui.Xaml.MainWindow.199}">
                <DockPanel>
                    <TextBox x:Name="DiagnosticsSearch"
                             DockPanel.Dock="Top"
                             Margin="7"
                             ToolTip="{DynamicResource Ui.Xaml.MainWindow.200}"
                             TextChanged="DiagnosticsSearch_TextChanged" />
                    <DataGrid x:Name="DiagnosticsGrid"
                              ItemsSource="{Binding FilteredDiagnostics}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="{StaticResource PanelBrush}"
                              Foreground="{StaticResource TextBrush}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Ui.Xaml.MainWindow.201}"
                                                Binding="{Binding Severity, Converter={StaticResource LocalizedDiagnosticSeverityConverter}}"
                                                Width="90" />
                            <DataGridTextColumn Header="{DynamicResource Ui.Xaml.MainWindow.202}"
                                                Binding="{Binding Code}"
                                                Width="105" />
                            <DataGridTextColumn Header="{DynamicResource Ui.Xaml.MainWindow.203}"
                                                Binding="{Binding Converter={StaticResource LocalizedDiagnosticMessageConverter}}"
                                                Width="*" />
                            <DataGridTextColumn Header="{DynamicResource Ui.Xaml.MainWindow.204}"
                                                Binding="{Binding NodeKey}"
                                                Width="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="{DynamicResource Ui.Xaml.MainWindow.205}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="DirtyText" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="DocumentStatsText" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="AssetStatusText" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
