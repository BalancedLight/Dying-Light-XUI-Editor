<Window x:Class="XuiEditor.Wpf.CopyXuiPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Copy XUI Properties"
        Width="820"
        Height="650"
        MinWidth="650"
        MinHeight="480"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SourceText"
                   Grid.Row="0"
                   Margin="0,0,0,10"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Search"
                       VerticalAlignment="Center" />
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="1"
                     TextChanged="SearchTextBox_TextChanged" />
            <Button Grid.Column="2"
                    Margin="8,0,0,0"
                    Content="Authored"
                    ToolTip="Select all copyable properties authored by the source element"
                    Click="SelectAuthored_Click" />
            <Button Grid.Column="3"
                    Content="All values"
                    ToolTip="Select authored properties and inherited defaults"
                    Click="SelectAll_Click" />
            <Button Grid.Column="4"
                    Content="Clear"
                    Click="Clear_Click" />
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,10,0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="205" />
                <ColumnDefinition Width="125" />
                <ColumnDefinition Width="105" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"
                       Text="Property"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="2"
                       Text="Category"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="3"
                       Text="Source"
                       FontWeight="SemiBold" />
            <TextBlock Grid.Column="4"
                       Text="Value"
                       FontWeight="SemiBold" />
        </Grid>

        <ListBox x:Name="PropertyList"
                 Grid.Row="3"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3"
                          ToolTip="{Binding ToolTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="205" />
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  IsEnabled="{Binding CanCopy}"
                                  VerticalAlignment="Center"
                                  Click="OptionCheckBox_Click" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Category}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding SourceLabel}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding Value}"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="4"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="SelectionSummaryText"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="ErrorText"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">
                <Button Content="Cancel"
                        IsCancel="True"
                        MinWidth="85" />
                <Button Content="Copy selected"
                        IsDefault="True"
                        MinWidth="110"
                        Click="Copy_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
