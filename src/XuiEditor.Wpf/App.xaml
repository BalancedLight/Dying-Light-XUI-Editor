                                            Property="Padding"
                                            Value="9,4" />
                                    <Setter TargetName="IconPresenter"
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    <Setter TargetName="GestureText"
                                            Property="Visibility"
                                            Value="Collapsed" />
