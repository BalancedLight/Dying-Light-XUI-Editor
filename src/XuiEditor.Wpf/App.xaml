                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource MutedTextBrush}" />
                                    <Setter TargetName="MenuItemRoot"
                                            Property="Opacity"
                                            Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
