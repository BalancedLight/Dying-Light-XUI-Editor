<Window x:Class="XuiEditor.Wpf.AddXuiElementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.Xaml.AddXuiElementWindow.001}"
        Width="590"
        Height="700"
        MinWidth="520"
        MinHeight="600"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ParentText"
                   Grid.Row="0"
                   Foreground="{StaticResource MutedTextBrush}"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.002}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <ComboBox x:Name="PresetCombo"
                              SelectionChanged="PresetCombo_SelectionChanged" />
                    <ComboBox x:Name="CatalogClassCombo"
                              Margin="0,5,0,0"
                              Visibility="Collapsed"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              DisplayMemberPath="Name"
                              SelectionChanged="CatalogClassCombo_SelectionChanged" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.003}" VerticalAlignment="Center" />
                <TextBox x:Name="IdText"
                         Grid.Row="1" Grid.Column="1" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.004}" VerticalAlignment="Center" />
                <Grid Grid.Row="2" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="WidthText" Grid.Column="0" />
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.005}"
                               Margin="7,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="HeightText" Grid.Column="2" />
                </Grid>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.006}" VerticalAlignment="Center" />
                <Grid Grid.Row="3" Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="XText" Grid.Column="0" />
                    <TextBlock Grid.Column="1"
                               Text=","
                               Margin="7,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <TextBox x:Name="YText" Grid.Column="2" />
                </Grid>

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.007}" VerticalAlignment="Center" />
                <TextBox x:Name="ContentText"
                         Grid.Row="4" Grid.Column="1" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.008}" VerticalAlignment="Center" />
                <TextBox x:Name="ImagePathText"
                         Grid.Row="5" Grid.Column="1" />

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.009}" VerticalAlignment="Center" />
                <TextBox x:Name="ColorText"
                         Grid.Row="6" Grid.Column="1" />

                <TextBlock Grid.Row="7" Grid.Column="0"
                           Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.010}" VerticalAlignment="Center" />
                <TextBox x:Name="FontText"
                         Grid.Row="7" Grid.Column="1" />

                <TextBlock Grid.Row="8" Grid.Column="0"
                           Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.011}" VerticalAlignment="Center" />
                <TextBox x:Name="VisualText"
                         Grid.Row="8" Grid.Column="1" />

                <TextBlock x:Name="PresetHelpText"
                           Grid.Row="9" Grid.ColumnSpan="2"
                           Margin="0,10,0,5"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap" />

                <Expander x:Name="AdvancedXmlExpander"
                          Grid.Row="10"
                          Grid.ColumnSpan="2"
                          Header="{DynamicResource Ui.Xaml.AddXuiElementWindow.012}"
                          Margin="0,5,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{DynamicResource Ui.Xaml.AddXuiElementWindow.013}"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="RawXmlText"
                                 MinHeight="210"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap"
                                 SpellCheck.IsEnabled="False" />
                    </DockPanel>
                </Expander>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{DynamicResource Ui.Xaml.AddXuiElementWindow.014}"
                    IsCancel="True"
                    MinWidth="85" />
            <Button x:Name="ConfirmButton"
                    Content="{DynamicResource Ui.Xaml.AddXuiElementWindow.015}"
                    IsDefault="True"
                    MinWidth="95"
                    Click="Add_Click" />
        </StackPanel>
    </Grid>
</Window>
