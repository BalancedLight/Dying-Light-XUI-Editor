<Window x:Class="XuiEditor.Wpf.GridSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.Xaml.GridSettingsWindow.001}"
        Width="510"
        Height="345"
        MinWidth="460"
        MinHeight="320"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   Text="{DynamicResource Ui.Xaml.GridSettingsWindow.002}"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Ui.Xaml.GridSettingsWindow.003}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{DynamicResource Ui.Xaml.GridSettingsWindow.004}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="{DynamicResource Ui.Xaml.GridSettingsWindow.005}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="{DynamicResource Ui.Xaml.GridSettingsWindow.006}" FontWeight="SemiBold" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Ui.Xaml.GridSettingsWindow.007}" VerticalAlignment="Center" />
            <TextBox x:Name="MinorSizeText" Grid.Column="1" Margin="0,0,8,0" />
            <TextBox x:Name="MinorColorText" Grid.Column="2" Margin="0,0,8,0" />
            <RadioButton x:Name="MinorSnap"
                         Grid.Column="3"
                         GroupName="SnapTier"
                         Content="{DynamicResource Ui.Xaml.GridSettingsWindow.008}" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Ui.Xaml.GridSettingsWindow.009}" VerticalAlignment="Center" />
            <TextBox x:Name="MajorSizeText" Grid.Column="1" Margin="0,0,8,0" />
            <TextBox x:Name="MajorColorText" Grid.Column="2" Margin="0,0,8,0" />
            <RadioButton x:Name="MajorSnap"
                         Grid.Column="3"
                         GroupName="SnapTier"
                         Content="{DynamicResource Ui.Xaml.GridSettingsWindow.010}" />
        </Grid>

        <Grid Grid.Row="4" Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Ui.Xaml.GridSettingsWindow.011}" VerticalAlignment="Center" />
            <TextBox x:Name="CoarseSizeText" Grid.Column="1" Margin="0,0,8,0" />
            <TextBox x:Name="CoarseColorText" Grid.Column="2" Margin="0,0,8,0" />
            <RadioButton x:Name="CoarseSnap"
                         Grid.Column="3"
                         GroupName="SnapTier"
                         Content="{DynamicResource Ui.Xaml.GridSettingsWindow.012}" />
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="5"
                   Margin="0,10,0,0"
                   Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{DynamicResource Ui.Xaml.GridSettingsWindow.013}" IsCancel="True" MinWidth="85" />
            <Button Content="{DynamicResource Ui.Xaml.GridSettingsWindow.014}"
                    IsDefault="True"
                    MinWidth="85"
                    Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
