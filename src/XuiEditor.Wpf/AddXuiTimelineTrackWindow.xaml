<Window x:Class="XuiEditor.Wpf.AddXuiTimelineTrackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Ui.Animation.TrackDialog.Title}"
        Width="480"
        Height="245"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{DynamicResource Ui.Animation.Dialog.Property}"
                   Foreground="{StaticResource MutedTextBrush}"
                   VerticalAlignment="Center" />
        <ComboBox x:Name="PropertyComboBox"
                  Grid.Column="1"
                  IsEditable="True"
                  SelectionChanged="Property_Changed"
                  LostKeyboardFocus="Property_Changed" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Text="{DynamicResource Ui.Animation.TrackDialog.Value}"
                   Foreground="{StaticResource MutedTextBrush}"
                   VerticalAlignment="Center" />
        <TextBox x:Name="ValueTextBox"
                 Grid.Row="1" Grid.Column="1"
                 Margin="0,8,0,0" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                   Margin="0,10,0,0"
                   Text="{DynamicResource Ui.Animation.TrackDialog.Hint}"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource Ui.Common.Cancel}"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="{DynamicResource Ui.Animation.TrackDialog.Create}"
                    MinWidth="100"
                    IsDefault="True"
                    Click="Create_Click" />
        </StackPanel>
    </Grid>
</Window>
